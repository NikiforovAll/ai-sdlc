---
import '@fontsource-variable/archivo';
import '../styles/global.css';
import DevLive from '../components/DevLive.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Inline rather than a file in `public/`: the export folds this page into one
        HTML file that opens from `file://`, and a linked icon would be the one
        asset it could not carry. */}
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23fff'/%3E%3Crect x='1.5' y='1.5' width='13' height='13' fill='none' stroke='%23dadada'/%3E%3Crect x='1.5' y='1.5' width='6' height='6' fill='%23111'/%3E%3Crect x='8.5' y='8.5' width='6' height='6' fill='%230f6b3c'/%3E%3C/svg%3E"
    />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <!--
    THESIS: The whole team document on one screen — a dense, hairline-ruled module
    mosaic; refuses the airy sidebar-and-cards internal-tool dashboard.
    OWN-WORLD: Base white #FFFFFF, ink #111111, utility green #0F6B3C for tabs and
    signals only, line gray #DADADA hairlines, surface gray #F2F2F2, washi #F7F7F7;
    one compact gothic (Archivo) at a strict scale 56/28/20/16/14/12/10/9; every module
    ruled and tabbed, packed edge to edge, full-bleed; nothing wastes a pixel.
    STORY: A team member finds their role, filters the whole document to it,
    switches view (FLOW / GRID / PLAYBOOK), expands an activity into its
    sub-process, and drills into the right-hand drawer; open slots read as the
    team's roadmap; tooling fires on workflow events, not just process position.
    FIRST VIEWPORT: Document masthead with green tab and version/status strip; a
    dense stat strip; the view/filter bar; FIG.01 flow swimlane spanning the
    full width.
    FORM: Japanese contemporary high-density web — dealt challenger, bolder round,
    won both axes; seed f4239808.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md
    -->
    <slot />
    {import.meta.env.DEV && <DevLive />}
  </body>
</html>
