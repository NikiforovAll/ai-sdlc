---
import Layout from '../layouts/Layout.astro';
import OverviewDoc from '../components/OverviewDoc.astro';
import { overviewModel } from '../lib/docs';

const model = await overviewModel();
---

<Layout title={`${model.team.name} — ai-sdlc`} description={model.team.note}>
  <OverviewDoc model={model} />
</Layout>
