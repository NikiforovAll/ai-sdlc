---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { countOpenSlots, LEVEL_LABELS } from '../lib/derive';
import type { AnyActivity } from '../lib/derive';

const teams = await getCollection('teams');
const teamEntry = teams[0];
const team = teamEntry.data;
const teamId = teamEntry.id;

const allProcesses = await getCollection('processes');
const procs = allProcesses
  .filter((p) => p.id.startsWith(`${teamId}/`))
  .map((p) => ({ slug: p.id.split('/')[1], data: p.data }));

const countActivities = (activities: AnyActivity[]): number =>
  activities.reduce((n, a) => n + 1 + countActivities(a.activities ?? []), 0);

const walk = (activities: AnyActivity[], fn: (a: AnyActivity) => void) => {
  for (const a of activities) {
    fn(a);
    walk(a.activities ?? [], fn);
  }
};

const procStats = procs.map((p) => ({
  ...p,
  activities: countActivities(p.data.activities),
  open: countOpenSlots(p.data.activities),
}));

const totalActivities = procStats.reduce((n, p) => n + p.activities, 0);
const totalOpen = procStats.reduce((n, p) => n + p.open, 0);

// Which processes touch each artifact, harness, and event — the catalogs are
// shared, so "used by nothing" is a fact worth showing.
const artifactUse = new Map<string, Set<string>>();
const harnessUse = new Map<string, Set<string>>();
for (const p of procs) {
  walk(p.data.activities, (a) => {
    for (const art of [...(a.consumes ?? []), ...a.produces]) {
      artifactUse.set(art, (artifactUse.get(art) ?? new Set()).add(p.data.name));
    }
    if (a.tooling) {
      harnessUse.set(a.tooling.harness, (harnessUse.get(a.tooling.harness) ?? new Set()).add(p.data.name));
    }
  });
}
for (const s of team.skills) {
  harnessUse.set(s.harness, harnessUse.get(s.harness) ?? new Set());
}

const eventUse = new Map<string, string[]>();
for (const s of team.skills) {
  for (const w of s.when) {
    if (!w.event) continue;
    eventUse.set(w.event, [...(eventUse.get(w.event) ?? []), s.name]);
  }
}

const stats = [
  { n: procs.length, label: 'Processes' },
  { n: team.roles.length, label: 'Roles' },
  { n: totalActivities, label: 'Activities · all' },
  { n: team.artifacts.length, label: 'Artifacts' },
  { n: team.harnesses.length, label: 'Harnesses' },
  { n: team.skills.length, label: 'Skills' },
  { n: team.events.length, label: 'Events' },
  { n: totalOpen, label: 'Open slots', open: true },
];
---

<Layout title={`${team.name} — ai-sdlc`} description={team.description}>
  <main>
    <header class="mast module">
      <div class="mast__top">
        <span class="tab">TEAM DOCUMENT</span>
        <span class="mast__file">content/teams/{teamId}/</span>
        <span class="mast__status">
          VERSION {team.version} · STATUS <strong class:list={{ 'mast__living': team.status === 'living' }}>{team.status.toUpperCase()}</strong>
        </span>
      </div>
      <div class="mast__main">
        <h1 class="mast__name">{team.name}</h1>
        {team.description && <p class="mast__desc">{team.description}</p>}
      </div>
      <dl class="mast__stats">
        {stats.map((s) => (
          <div class="mast__stat">
            <dd class:list={['mast__stat-n', { 'mast__stat-n--open': s.open && s.n > 0 }]}>{s.n}</dd>
            <dt class="mast__stat-label">{s.label}</dt>
          </div>
        ))}
      </dl>
    </header>

    <section class="module" aria-label="Processes">
      <div class="module__head">
        <span class="tab">PROCESSES</span>
        <span class="module__title">Ways Work Flows Through This Team</span>
        <span class="module__meta">one file each · shared catalogs · open a process to read its figures</span>
      </div>
      <ul class="procs">
        {procStats.map((p) => (
          <li class="proc">
            <a class="proc__link" href={`/${p.slug}`}>
              <span class="proc__name">{p.data.name}</span>
              <span class="proc__go" aria-hidden="true">→</span>
            </a>
            {p.data.description && <p class="proc__desc">{p.data.description}</p>}
            <ol class="proc__stages">
              {p.data.stages.map((st) => <li class="proc__stage">{st.name}</li>)}
            </ol>
            <dl class="proc__nums">
              <div><dd>{p.activities}</dd><dt>Activities</dt></div>
              <div><dd>{p.data.stages.length}</dd><dt>Stages</dt></div>
              <div><dd class:list={{ 'proc__open': p.open > 0 }}>{p.open}</dd><dt>Open slots</dt></div>
            </dl>
            {p.data.constraint && (
              <p class="proc__constraint">
                <span class="chip chip--inverse">① {team.artifacts.find((a) => a.id === p.data.constraint!.artifact)?.name ?? p.data.constraint.artifact}</span>
                {p.data.constraint.note}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>

    <div class="cats">
      <section class="module cat" aria-label="Roles">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Roles</span>
          <span class="module__meta">the vertical axis of every figure</span>
        </div>
        <ul class="rows">
          {team.roles.map((r) => (
            <li class="row">
              <span class="row__name">{r.name}</span>
              <span class="row__id">{r.id}</span>
              {r.note && <span class="row__note">{r.note}</span>}
            </li>
          ))}
        </ul>
      </section>

      <section class="module cat" aria-label="Harnesses">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Harnesses</span>
          <span class="module__meta">runtimes capability can live in</span>
        </div>
        <ul class="rows">
          {team.harnesses.map((h) => (
            <li class="row">
              <span class="row__name">{h.name}</span>
              <span class="row__id">{h.id}</span>
              {h.note && <span class="row__note">{h.note}</span>}
              <span class="row__use">
                {[...(harnessUse.get(h.id) ?? [])].join(' · ') || 'shelf inventory'}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="module cat" aria-label="Artifacts">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Artifacts</span>
          <span class="module__meta">the joints — every edge is one changing hands</span>
        </div>
        <ul class="rows rows--tight">
          {team.artifacts.map((a) => (
            <li class="row">
              <span class="row__name">{a.name}</span>
              <span class="row__id">{a.id}</span>
              <span class="row__use">
                {[...(artifactUse.get(a.id) ?? [])].join(' · ') || 'unused'}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="module cat" aria-label="Events">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Events</span>
          <span class="module__meta">moments, not errors · skills attach to them</span>
        </div>
        <ul class="rows">
          {team.events.map((e) => (
            <li class="row">
              <span class="row__name">{e.name}</span>
              <span class="row__id">{e.id}</span>
              {e.description && <span class="row__note">{e.description}</span>}
              <span class="row__use">{(eventUse.get(e.id) ?? []).join(' · ') || 'no play yet'}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="module cat cat--wide" aria-label="Tooling">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Tooling</span>
          <span class="range">
            <span class="chip chip--muted range__step">Harness</span>
            <span class="chip chip--muted range__step">Command</span>
            <span class="chip chip--muted range__step">Skill</span>
          </span>
          <span class="module__meta">one catalog, widest to narrowest</span>
        </div>
        <ul class="rows rows--tight">
          {team.skills.map((s) => (
            <li class="row row--skill">
              <span class="row__name">{s.name}</span>
              <span class="chip chip--muted">{team.harnesses.find((h) => h.id === s.harness)?.name ?? s.harness}</span>
              {s.level && <span class="chip chip--muted">{LEVEL_LABELS[s.level]}</span>}
              <span class="row__note">{s.roles.map((r) => team.roles.find((x) => x.id === r)?.name ?? r).join(' · ')}</span>
              <span class="row__use">
                {s.when.map((w) => (w.event ? `on ${team.events.find((e) => e.id === w.event)?.name ?? w.event}` : w.activity ?? '')).filter(Boolean).join(' · ') || 'standing'}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style>
  .procs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  }
  .proc {
    padding: 14px 16px 16px;
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .proc:first-child {
    border-left: none;
  }
  .proc__link {
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
  }
  .proc__name {
    font-size: var(--display-md);
    line-height: 30px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    border-bottom: 2px solid transparent;
    transition: border-color 0.14s var(--ease-out), color 0.14s var(--ease-out);
  }
  .proc__go {
    font-size: var(--subhead);
    color: var(--muted);
    transition: transform 0.14s var(--ease-out), color 0.14s var(--ease-out);
  }
  .proc__link:hover .proc__name {
    color: var(--accent);
    border-color: var(--accent);
  }
  .proc__link:hover .proc__go {
    color: var(--accent);
    transform: translateX(4px);
  }
  .proc__desc {
    font-size: var(--body);
    line-height: 17px;
    color: var(--sub);
    max-width: 56ch;
  }
  .proc__stages {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }
  .proc__stage {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .proc__stage + .proc__stage::before {
    content: '→';
    margin-right: 5px;
    color: var(--muted);
    font-weight: 400;
  }
  .proc__nums {
    display: flex;
    border-top: 1px solid var(--line);
    margin-top: 2px;
  }
  .proc__nums > div {
    padding: 7px 14px 6px 0;
  }
  .proc__nums dd {
    font-size: var(--subhead);
    font-weight: 800;
    line-height: 20px;
  }
  .proc__open {
    color: var(--accent);
  }
  .proc__nums dt {
    font-size: var(--micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .proc__constraint {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font-size: var(--label);
    line-height: 15px;
    color: var(--sub);
    background: var(--washi);
    padding: 7px 8px;
  }
  .proc__constraint .chip {
    flex: none;
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 8px;
  }
  .cat--wide {
    grid-column: 1 / -1;
  }
  /* The head states the span of the catalog: widest runtime to narrowest skill. */
  .range {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }
  .range__step + .range__step::before {
    content: '→';
    margin-right: 5px;
    color: var(--muted);
    font-weight: 400;
  }
  .rows {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    padding: 7px 8px 6px;
    border-bottom: 1px solid var(--line);
  }
  .rows--tight .row {
    padding: 5px 8px 4px;
  }
  .row:last-child {
    border-bottom: none;
  }
  .row:nth-child(even) {
    background: var(--washi);
  }
  .row__name {
    font-size: var(--body);
    font-weight: 700;
  }
  .row__id {
    font-size: var(--micro);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .row__note {
    font-size: var(--label);
    line-height: 15px;
    color: var(--sub);
    flex-basis: 100%;
  }
  .row--skill .row__note {
    flex-basis: auto;
  }
  .row__use {
    margin-left: auto;
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .proc {
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .proc:first-child {
      border-top: none;
    }
    .row__use {
      margin-left: 0;
      flex-basis: 100%;
      white-space: normal;
    }
  }
</style>
