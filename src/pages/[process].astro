---
import Layout from '../layouts/Layout.astro';
import ProcessDoc from '../components/ProcessDoc.astro';
import RoleDimStyle from '../components/RoleDimStyle.astro';
import { processModels } from '../lib/docs';
import type { ProcessModel } from '../lib/docs';

export async function getStaticPaths() {
  return (await processModels()).map((model) => ({
    params: { process: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props as { model: ProcessModel };
---

<Layout title={`${model.process.name} — ${model.team.name}`} description={model.process.description}>
  <RoleDimStyle roles={model.team.roles} />
  <ProcessDoc model={model} />
</Layout>
