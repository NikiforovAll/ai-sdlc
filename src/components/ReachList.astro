---
// The team document's drawer answers "where is this actually used" one level
// below the process name: which activity, whose it is, and how it is reached for.
// Tools and artifacts ask that question in the same shape — only the verb differs
// — so the rows are written once and grouped by process, because a reader is
// looking for a place to go next and a process is how they name places.
import { LEVEL_LABELS } from '../lib/derive';
import { useHref, VERB } from '../lib/docs';
import type { Reach } from '../lib/docs';
import { proseBlocks } from '../lib/markdown';

interface Props {
  rows: Reach[];
  /** What the reader is told when nothing reaches for the entry. */
  empty: string;
  /** Resolves the moment a recommendation is bound to. */
  eventNames?: Map<string, string>;
  /** Set by the export, where every document shares one file and there are no routes. */
  inline?: boolean;
}
const { rows, empty, eventNames, inline = false } = Astro.props;

const prose = await proseBlocks(rows.flatMap((r) => [r.usage, r.need]));

// Grouped twice, both in first-seen order — the order the processes are listed in
// everywhere else on the document. By process, because a reader is looking for a
// place to go next and a process is how they name places. Then by relation,
// because the verb is the same sentence on every row it covers: stated once as
// the list's own label, it stops being four gray words in front of each activity,
// and the row is free to lead with the only part that varies and the only part
// that is a door.
type Kind = { kind: Reach['kind']; rows: Reach[] };
const groups: { slug: string; process: string; kinds: Kind[] }[] = [];
for (const r of rows) {
  let g = groups.find((x) => x.slug === r.slug);
  if (!g) groups.push((g = { slug: r.slug, process: r.process, kinds: [] }));
  let k = g.kinds.find((x) => x.kind === r.kind);
  if (!k) g.kinds.push((k = { kind: r.kind, rows: [] }));
  k.rows.push(r);
}

---

{groups.length === 0 ? (
  <p class="reach__none">{empty}</p>
) : (
  groups.map((g) => (
    <div class="reach">
      <a class="reach__proc" href={useHref({ slug: g.slug, label: g.process }, inline)} data-goto={g.slug}>
        {g.process}
      </a>
      {g.kinds.map((k) => (
        <div class="reach__kind">
          <p class="reach__verb">{VERB[k.kind]}</p>
          <ul class="reach__rows">
            {k.rows.map((r) => (
              <li class="reach__row">
                <p class="reach__line">
                  <a
                    class="row__go reach__act"
                    href={useHref({ slug: r.slug, label: r.activity, focus: `act-${r.actId}` }, inline)}
                    data-goto={r.slug}
                    data-focus={`act-${r.actId}`}
                  >
                    {r.activity}
                  </a>
                  {/* Delegation is a chip everywhere else it is stated — the playbook
                      item, the activity drawer — so it stays a chip here, and it takes
                      the right edge the catalog rows give their usage tag rather than
                      trailing the owner at a different x on every row. */}
                  {r.level && <span class="chip chip--muted reach__level">{LEVEL_LABELS[r.level]}</span>}
                </p>
                {(r.stage || r.roles.length > 0) && (
                  <p class="reach__meta">
                    {/* Place and owner are two axes, and a `·` between them made the
                        run's first term mean the stage on one row and the role on the
                        next, because a sub-activity names no stage of its own. They
                        keep one line and separate by voice instead: the owner in ink,
                        because the reader scanning for their own name is scanning for
                        that, and where it sits behind it. */}
                    {r.stage && <span class="reach__stage">{r.stage}</span>}
                    {r.roles.length > 0 && <span class="reach__roles">{r.roles.join(', ')}</span>}
                  </p>
                )}
                {/* The moment is a catalog entry with a panel of its own, and it is a
                    door everywhere else it is named — the activity drawer, the
                    playbook. It stayed text here only because this list was written
                    before the events catalog had a panel. An id the catalog does not
                    define has nowhere to go, so it stays text rather than drawing an
                    affordance that opens nothing. */}
                {r.event && (
                  eventNames?.has(r.event) ? (
                    <button type="button" class="reach__event reach__event--go" data-detail-key={`event:${r.event}`}>
                      <svg class="reach__bolt" viewBox="0 0 8 10" aria-hidden="true"><path d="M4.6 0 1 5.6h2.3L2.7 10 7 4.2H4.4Z" fill="currentColor" /></svg>
                      <span>{eventNames.get(r.event)}</span>
                    </button>
                  ) : (
                    <p class="reach__event">
                      <svg class="reach__bolt" viewBox="0 0 8 10" aria-hidden="true"><path d="M4.6 0 1 5.6h2.3L2.7 10 7 4.2H4.4Z" fill="currentColor" /></svg>
                      {eventNames?.get(r.event) ?? r.event}
                    </p>
                  )
                )}
                {r.usage && <div class="reach__usage prose-md" set:html={prose.get(r.usage)} />}
                {r.need && <div class="reach__usage reach__need prose-md" set:html={prose.get(r.need)} />}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ))
)}

<style>
  /* A process is a wider break than the 7px between two rows inside one, so it
     takes the reading step rather than a value only slightly above it. */
  .reach + .reach {
    margin-top: 14px;
  }
  /* The process is the kicker over its own rows rather than a row of its own: the
     reader is inside one catalog entry, and what varies down the panel is where
     it is reached for. */
  .reach__proc {
    display: inline-block;
    font-size: var(--micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    border-bottom: 1px solid rgba(15, 107, 60, 0.35);
    transition: border-color 0.14s var(--ease-out);
  }
  .reach__proc:hover,
  .reach__proc:focus-visible {
    border-bottom-color: var(--accent);
  }
  /* The relation is stated once over the rows it covers, so it is a label and not
     a heading. Three micro-caps runs now stack — the section, the process, the
     relation — and the section head is already 700 gray caps, so a fourth voice
     was needed rather than a fourth copy of the same one: the process takes the
     green and the underline it has as a door, and the relation drops to 400,
     which is the only weight left below both. */
  .reach__kind {
    margin-top: 6px;
    border-left: 1px solid var(--line);
    padding-left: 8px;
  }
  .reach__kind + .reach__kind {
    margin-top: 11px;
  }
  .reach__verb {
    font-size: var(--micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .reach__rows {
    list-style: none;
    margin-top: 5px;
  }
  /* A row runs to four lines when it carries usage prose, and 7px of air between
     rows against 3px inside one left the boundary to be inferred. The seam is the
     divider everywhere else peers are listed, so it is the divider here. */
  .reach__row + .reach__row {
    margin-top: 7px;
    border-top: 1px solid var(--line);
    padding-top: 7px;
  }
  .reach__line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    font-size: var(--body);
    line-height: 17px;
  }
  .reach__level {
    flex: none;
  }
  /* The rule and the hover are `.row__go` — this is the same door every other
     catalog row draws. What is local is the weight and the ink: here the
     activity is the thing being named, not an aside beside it. */
  .reach__act {
    font-weight: 700;
    color: var(--ink);
  }
  .reach__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 7px;
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
    margin-top: 3px;
  }
  .reach__roles {
    font-weight: 700;
    color: var(--ink);
  }
  .reach__event {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-top: 3px;
  }
  /* A door, so it carries the hairline the other doors in the panel carry — under
     the words only, because an underlined bolt reads as a struck-through glyph. */
  .reach__event--go span {
    border-bottom: 1px solid rgba(15, 107, 60, 0.35);
    transition: border-color 0.14s var(--ease-out);
  }
  .reach__event--go:hover span,
  .reach__event--go:focus-visible span {
    border-bottom-color: var(--accent);
  }
  /* The same bolt the playbook draws, at the same size: one glyph for one meaning
     across the two surfaces that state when a tool is reached for. */
  .reach__bolt {
    width: 7px;
    height: 9px;
  }
  /* Authored prose, so it takes the body step rather than an off-scale one — a
     step under the row it explains, level with the indexes elsewhere. */
  .reach__usage {
    font-size: var(--body);
    line-height: 17px;
    color: var(--sub);
    margin-top: 4px;
  }
  /* A need is not an aside about the row — it is what the row is for, the only
     sentence saying what would close the gap, so it keeps the ink the activity has. */
  .reach__need {
    color: var(--ink);
  }
  /* An aside about a list must not outweigh the rows it stands in for, so the
     empty line takes the same body step the rows do, not the drawer's prose. */
  .reach__none {
    font-size: var(--body);
    line-height: 17px;
    color: var(--sub);
  }
</style>
