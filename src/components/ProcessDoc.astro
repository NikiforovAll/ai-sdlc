---
// One process document: masthead, view/filter bar, the three figures, the drawer.
// It is a component rather than a page body because the export composes several
// of them into one file — see `_plans/spec-cli-layer.md`, D-CLI-5.
import FlowFigure from './FlowFigure.astro';
import GridFigure from './GridFigure.astro';
import PlaybookFigure from './PlaybookFigure.astro';
import Drawer from './Drawer.astro';
import RepoMark from './RepoMark.astro';
import { docPath } from '../lib/docs';
import type { ProcessModel } from '../lib/docs';

interface Props {
  model: ProcessModel;
  /** The export renders every document at once and shows one; a route shows its own. */
  hidden?: boolean;
  /** Set by the export, where every document shares one file and there are no routes. */
  inline?: boolean;
}
const { model, hidden = false, inline = false } = Astro.props;
const { slug, team, process, doc, file, siblings } = model;
const docHref = (s: string) => (inline ? '#' : docPath(s));

const views = [
  { id: 'flow', label: 'FLOW' },
  { id: 'grid', label: 'GRID' },
  { id: 'playbook', label: 'PLAYBOOK' },
];
---

<section class="doc" data-doc={slug} data-doc-kind="process" hidden={hidden}>
  <main data-role="" data-view="flow">
    <header class="mast mast--line module">
      <div class="mast__top">
        <span class="tab">PROCESS</span>
        <a class="mast__up" href={inline ? '#' : docPath()} data-goto="">↑ {team.name}</a>
        <h1 class="mast__title">
          <button type="button" class="mast__open" data-open-process aria-expanded="false">
            {process.name}<span class="mast__open-mark" aria-hidden="true">▸</span>
          </button>
        </h1>
        <span class="mast__status">
          {doc.activities.length} ACTIVITIES · {process.stages.length} STAGES
        </span>
        <RepoMark />
      </div>
      <nav class="mast__switch" aria-label="Process">
        <span class="tab tab--quiet">PROCESSES</span>
        {siblings.map((s) => (
          <a
            class="mast__proc"
            href={docHref(s.slug)}
            data-goto={s.slug}
            aria-current={s.slug === slug ? 'page' : undefined}
          >
            {s.name}
          </a>
        ))}
        <span class="mast__stagerun">
          {process.stages.map((st, i) => (
            <>
              {i > 0 && <span class="mast__stagesep" aria-hidden="true">→</span>}
              <span class="mast__stage">{st.name}</span>
            </>
          ))}
        </span>
      </nav>
    </header>

    <nav class="bar module" aria-label="View and filter">
      <div class="bar__views" role="group" aria-label="View mode">
        <span class="tab">VIEW</span>
        {views.map((v) => (
          <button class="bar__view" data-viewbtn={v.id} aria-pressed={v.id === 'flow' ? 'true' : 'false'}>
            {v.label}
          </button>
        ))}
      </div>
      <div class="bar__filter" role="group" aria-label="Filter by role">
        <span class="tab tab--quiet">LENS</span>
        <button class="filter__chip" data-filter="" aria-pressed="true">All roles</button>
        {doc.roles.map((r) => (
          <button class="filter__chip" data-filter={r.id} aria-pressed="false">{r.name}</button>
        ))}
        <span class="bar__readout" data-readout>all {doc.activities.length} activities in scope</span>
      </div>
    </nav>

    <div data-viewpanel="flow">
      <FlowFigure team={doc} docId={slug} />
    </div>
    <div data-viewpanel="grid">
      <GridFigure team={doc} />
    </div>
    <div data-viewpanel="playbook">
      <PlaybookFigure team={doc} />
    </div>
  </main>

  <Drawer
    team={doc}
    process={{
      name: process.name,
      note: process.note,
      description: process.description,
      stages: process.stages.length,
      activities: doc.activities.length,
      file,
    }}
  />
</section>

<script>
  import { panelNav } from '../lib/panel-nav';

  // Root-scoped, initialized once per process document. The export puts four of
  // these in one file, so nothing here may reach for a document-global singleton.
  const escapers: (() => void)[] = [];

  const init = (root: HTMLElement) => {
    const main = root.querySelector('main')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const acts = [...root.querySelectorAll<HTMLButtonElement>('button[data-act]')];
    const tools = [...root.querySelectorAll<HTMLButtonElement>('button[data-tool]')];
    const topActs = acts.filter((a) => a.dataset.depth === '0');
    const total = new Set(topActs.map((a) => a.dataset.act)).size;

    // View switcher
    const setView = (id: string) => {
      main.dataset.view = id;
      for (const b of root.querySelectorAll<HTMLElement>('[data-viewbtn]')) {
        b.setAttribute('aria-pressed', String(b.dataset.viewbtn === id));
      }
    };
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-viewbtn]')) {
      btn.addEventListener('click', () => setView(btn.dataset.viewbtn!));
    }

    // Role filter (counts top-level activities only)
    for (const chip of root.querySelectorAll<HTMLButtonElement>('.filter__chip')) {
      chip.addEventListener('click', () => {
        const role = chip.dataset.filter ?? '';
        main.dataset.role = role;
        for (const c of root.querySelectorAll('.filter__chip')) {
          c.setAttribute('aria-pressed', String(c === chip));
        }
        if (!role) {
          readout.textContent = `all ${total} activities in scope`;
        } else {
          const inScope = new Set(
            topActs.filter((a) => (a.dataset.roles ?? '').split(' ').includes(role)).map((a) => a.dataset.act)
          ).size;
          readout.textContent = `${chip.textContent?.trim()} — ${inScope} of ${total} activities in scope`;
        }
      });
    }

    // The mark is one reading position, and it lands on every node that names the
    // entry rather than on the one that was clicked: an artifact is drawn once per
    // edge that moves it, a role once per lane, so marking a single node would
    // leave the reader with the other appearances of the same thing unmarked.
    const doors = [...root.querySelectorAll<HTMLElement>('[data-detail-key]')].filter(
      (el) => !el.closest('[data-drawer]')
    );
    const clearMarks = () => {
      for (const b of [...acts, ...tools, ...doors]) b.setAttribute('aria-current', 'false');
    };
    // Same rule for an activity, which is drawn once per view — the flow, the
    // grid and the playbook each hold a node for it.
    const markAct = (id: string) => {
      for (const a of acts) if (a.dataset.act === id) a.setAttribute('aria-current', 'true');
    };

    // Drawer
    const drawer = root.querySelector<HTMLElement>('[data-drawer]')!;
    const procOpen = root.querySelector<HTMLButtonElement>('[data-open-process]');
    const back = drawer.querySelector<HTMLButtonElement>('[data-drawer-back]');
    const closeBtn = drawer.querySelector<HTMLButtonElement>('[data-drawer-close]');
    const nav = panelNav(drawer, {
      back,
      onBack: () => (back?.hidden ? closeBtn : back)?.focus(),
    });
    // `deeper` is a step taken from inside the open drawer, which is the only
    // move BACK is meant to undo — an entry opened from the page is a fresh read.
    const openDrawer = (key: string, deeper = false) => {
      nav.show(key, deeper);
      drawer.hidden = false;
      main.setAttribute('data-drawer-open', '');
      procOpen?.setAttribute('aria-expanded', String(key === '__process'));
    };
    const closeDrawer = () => {
      drawer.hidden = true;
      nav.clear();
      main.removeAttribute('data-drawer-open');
      clearMarks();
      procOpen?.setAttribute('aria-expanded', 'false');
    };

    // Every figure scrolls sideways inside its own track, so "bring this node
    // into view" is a scroll of that track, not of the page. The trailing-room
    // rule in this component's stylesheet names the same two classes: a track
    // the CSS does not know about has no room to scroll into, so the node would
    // stay behind the drawer and the fault would look like a script fault.
    const TRACK = '.fig__scroll, .grid__scroll';
    // The drawer is a fixed panel over the right edge: the width a reader can
    // actually see is the track minus that panel. Selecting a node underneath it
    // reads as nothing having happened at all.
    const visibleRight = () =>
      drawer.hidden ? window.innerWidth : Math.min(window.innerWidth, drawer.getBoundingClientRect().left);
    // Both moves wait two frames: the room the drawer leaves at the end of the
    // track is a style change, and a track measured in the same frame as the
    // opening still reports its old width — the node then stops short.
    const afterLayout = (fn: () => void) =>
      requestAnimationFrame(() => requestAnimationFrame(fn));
    // `nudge` moves the node just clear of the drawer and no further, which is
    // what a click wants — the reader chose where to look. `center` parks it
    // mid-way in the width the drawer leaves, which is what an arrival from a
    // catalog link wants, since the reader has not seen the figure yet.
    const bringIntoView = (btn: HTMLElement, mode: 'nudge' | 'center') =>
      afterLayout(() => {
        // Vertical first: `scrollIntoView` also moves the horizontal axis to
        // "nearest", which parks the node just inside the track's right edge —
        // exactly where the drawer is. The horizontal maths runs after it.
        if (mode === 'center') btn.scrollIntoView({ block: 'center' });
        const track = btn.closest<HTMLElement>(TRACK);
        if (!track) return;
        const trackBox = track.getBoundingClientRect();
        const box = btn.getBoundingClientRect();
        const limit = visibleRight();
        const delta =
          mode === 'center'
            ? box.left - trackBox.left - (Math.min(trackBox.right, limit) - trackBox.left - box.width) / 2
            : Math.max(0, box.right + 12 - limit);
        // Client rects and `scrollLeft` do not share a unit while the
        // wide-display `zoom` is in force, so the factor is measured — from the
        // rect already taken above, rather than a second read of the same box.
        track.scrollLeft += delta / (trackBox.width / track.clientWidth || 1);
      });
    procOpen?.addEventListener('click', () => {
      clearMarks();
      openDrawer('__process');
      drawer.querySelector<HTMLButtonElement>('[data-drawer-close]')?.focus();
    });
    for (const btn of acts) {
      btn.addEventListener('click', () => {
        const id = btn.dataset.act!;
        clearMarks();
        markAct(id);
        openDrawer(id);
        bringIntoView(btn, 'nudge');
      });
    }
    for (const btn of tools) {
      btn.addEventListener('click', () => {
        const id = btn.dataset.tool!;
        clearMarks();
        for (const s of tools) if (s.dataset.tool === id) s.setAttribute('aria-current', 'true');
        openDrawer(`tool:${id}`);
        bringIntoView(btn, 'nudge');
      });
    }
    // Catalog entities — artifacts, roles, harnesses, events — have no node of
    // their own to select, so they open by key from wherever they are named: an
    // edge label, a lane, a chip inside the drawer itself. One delegated listener
    // rather than a binding per element, because the drawer rewrites its own body
    // as the reader moves between panels.
    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-detail-key]');
      const key = el?.dataset.detailKey;
      if (!key || !nav.has(key)) return;
      const deeper = Boolean(el!.closest('[data-drawer]')) && !drawer.hidden;
      // A key that names an activity has a node on the page, so the link moves the
      // selection there as well as the panel — otherwise the drawer changes under
      // the reader while the marked node still points at where they came from.
      const actMarks = acts.filter((b) => b.dataset.act === key);
      const btn = actMarks[0];
      // A step taken from inside the drawer moves the mark only when the reader can
      // see it arrive. An entry with no node at all — a harness — and one whose only
      // nodes sit in a view that is not showing both leave the mark where it is:
      // BACK returns to the panel it came from, and that panel's node is still the
      // reading position. Losing the mark to a node nobody can see reads as the
      // click having deselected something.
      // Three ways a node names the same entry: an activity by id, a tool by the id
      // behind its prefix, a catalog entry by the key itself. All three land on
      // every node that names it, not on the one that happened to be clicked.
      const marks = [
        ...actMarks,
        ...(key.startsWith('tool:') ? tools.filter((t) => t.dataset.tool === key.slice(5)) : []),
        ...doors.filter((d) => d.dataset.detailKey === key),
      ];
      if (btn || !deeper || marks.some((m) => m.offsetParent !== null)) {
        clearMarks();
        for (const m of marks) m.setAttribute('aria-current', 'true');
      }
      if (btn) {
        const panel = btn.closest<HTMLElement>('[data-viewpanel]');
        if (panel?.dataset.viewpanel) setView(panel.dataset.viewpanel);
        for (let el = btn.closest<HTMLElement>('[data-subflow-panel]'); el; el = el.parentElement?.closest<HTMLElement>('[data-subflow-panel]') ?? null) {
          if (el.hidden) {
            root
              .querySelector<HTMLButtonElement>(`[data-expand="${CSS.escape(el.dataset.subflowPanel!)}"]`)
              ?.click();
          }
        }
      }
      openDrawer(key, deeper);
      if (btn) bringIntoView(btn, 'center');
      if (deeper) (nav.depth() ? back : closeBtn)?.focus();
    });
    root.querySelector('[data-drawer-close]')?.addEventListener('click', closeDrawer);
    escapers.push(() => {
      if (!drawer.hidden && !root.hidden) closeDrawer();
    });

    // A catalog link on the team document arrives as #act-<id> or #tool-<id> (a
    // route) or as an `aisdlc:focus` event (the export, which has no routes).
    // A hash is read, never written: a drawer opened by clicking a node is a
    // reading position, not an address, and writing it would fill the history
    // with noise.
    const focus = (target: string) => {
      const sep = target.indexOf('-');
      const kind = target.slice(0, sep);
      const id = target.slice(sep + 1);
      const key = kind === 'tool' ? `tool:${id}` : kind === 'act' ? id : null;
      if (!key || !nav.has(key)) return;
      // A tool that fills an activity has no button of its own — it is drawn as
      // the activity that reaches for it — so the link's node is that fill, and
      // the swimlane is where a reader expects to land: `acts` is in document
      // order, and the flow panel comes before the grid and the playbook. Only a
      // tool that is recommended rather than filled has a button of its own.
      // Without this the drawer opened onto a page where nothing was marked and
      // nothing moved.
      const btn = kind === 'tool'
        ? acts.find((b) => b.dataset.fills === id) ??
          tools.find((b) => b.dataset.tool === id)
        : acts.find((b) => b.dataset.act === id);
      if (btn) {
        // The node may live in a view that is not showing — a tool only has a button
        // in PLAYBOOK — so the link brings its own view with it.
        const panel = btn.closest<HTMLElement>('[data-viewpanel]');
        if (panel?.dataset.viewpanel) setView(panel.dataset.viewpanel);
        // An artifact with no top-level producer points at a sub-activity, whose node
        // sits in a collapsed inset — open every inset on the way down to it.
        for (let el = btn.closest<HTMLElement>('[data-subflow-panel]'); el; el = el.parentElement?.closest<HTMLElement>('[data-subflow-panel]') ?? null) {
          if (el.hidden) {
            root
              .querySelector<HTMLButtonElement>(`[data-expand="${CSS.escape(el.dataset.subflowPanel!)}"]`)
              ?.click();
          }
        }
        clearMarks();
        btn.setAttribute('aria-current', 'true');
      }
      // The drawer opens first: it takes the right edge of the window, and the
      // reveal below has to know how much room is left before it centres.
      openDrawer(key);
      if (btn) bringIntoView(btn, 'center');
    };
    root.addEventListener('aisdlc:focus', (e) => focus((e as CustomEvent<string>).detail));

    // Sub-process expand/collapse
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-expand]')) {
      btn.addEventListener('click', () => {
        const id = btn.dataset.expand!;
        const panel = btn.parentElement?.querySelector<HTMLElement>(`[data-subflow-panel="${CSS.escape(id)}"]`)
          ?? root.querySelector<HTMLElement>(`[data-subflow-panel="${CSS.escape(id)}"]`);
        if (!panel) return;
        const open = panel.hidden;
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = btn.textContent!.replace(open ? '▸' : '▾', open ? '▾' : '▸');
      });
    }
  };

  const roots = [...document.querySelectorAll<HTMLElement>('[data-doc-kind="process"]')];
  for (const root of roots) init(root);

  // One listener for the page: only the showing document has a drawer to close.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const escape of escapers) escape();
  });

  // A route holds exactly one process document, so the hash addresses it.
  if (roots.length === 1) {
    const root = roots[0];
    const fromHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (h) root.dispatchEvent(new CustomEvent('aisdlc:focus', { detail: h }));
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>

<style>
  /* The drawer is fixed over the right edge, so the last node in a figure has
     nowhere left to travel: without this much extra room at the end of the
     track, a selection at the end of a flow can never come out from behind the
     panel. The room only exists while the panel does. */
  main[data-drawer-open] :global(.fig__scroll),
  main[data-drawer-open] :global(.grid__scroll) {
    padding-right: calc(var(--drawer-w) + 16px);
  }

  main[data-view='flow'] [data-viewpanel]:not([data-viewpanel='flow']),
  main[data-view='grid'] [data-viewpanel]:not([data-viewpanel='grid']),
  main[data-view='playbook'] [data-viewpanel]:not([data-viewpanel='playbook']) {
    display: none;
  }
  .mast__up {
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.12s var(--ease-out), color 0.12s var(--ease-out);
  }
  .mast__up:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .mast__switch {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    padding: 6px 8px;
    border-top: 1px solid var(--line);
  }
  .mast__proc {
    border: 1px solid var(--ink);
    padding: 6px 10px 5px;
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.12s ease-out, color 0.12s ease-out;
  }
  .mast__proc:hover {
    background: var(--washi);
  }
  .mast__proc[aria-current='page'] {
    background: var(--ink);
    color: var(--white);
  }
  .mast__stagerun {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }
  .mast__stage {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .mast__stagesep {
    font-size: var(--micro);
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .mast__stagerun {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
