---
import type { Team, SubActivity } from '../lib/derive';
import { deriveSub, LEVEL_LABELS, levelIndex, nameOf, statesCapability } from '../lib/derive';

interface Props {
  team: Team;
  activities: SubActivity[];
}
const { team, activities } = Astro.props;
const d = deriveSub(activities);

const rolesUsed = team.roles.filter((r) => activities.some((a) => a.roles.includes(r.id)));
const cell = (roleId: string, col: number) =>
  d.placed.filter((p) => p.col === col && p.activity.roles[0] === roleId);
// A lane is drawn for every role the inset names, so a role that only ever comes
// second would get a lane it can never fill. The parent figure answers this with
// an echo, and the inset owes the same answer: without it the lane reads as "this
// role takes no part", which is the opposite of what the second role means.
const echoes = (roleId: string, col: number) =>
  d.placed.filter(
    (p) => p.col === col && p.activity.roles[0] !== roleId && p.activity.roles.includes(roleId)
  );
const roleName = (id: string) => nameOf(team.roles, id);
const cols = [...Array(d.cols).keys()];
---

<div class="subflow" style={`--subcols:${d.cols}`}>
  {rolesUsed.map((r) => (
    <div class="subflow__row" data-roles={r.id}>
      <span class="subflow__role">{r.name}</span>
      {cols.map((c) => (
        <div class="subflow__cell">
          {cell(r.id, c).map((p) => (
            <>
              <button
                class={`subflow__act${p.activity.open ? ' subflow__act--open' : ''}`}
                data-act={p.activity.id}
                data-fills={p.activity.tooling?.tool}
                data-roles={p.activity.roles.join(' ')}
                data-depth="sub"
                aria-label={`${p.activity.name} — details`}
              >
                <span class="subflow__name">{p.activity.name}</span>
                {statesCapability(p.activity) && (
                  <span class="subflow__level">
                    <span class="subflow__level-name">
                      {p.activity.tooling ? LEVEL_LABELS[p.activity.tooling.level] : 'OPEN SLOT'}
                    </span>
                    <span
                      class={`subflow__track${p.activity.tooling ? '' : ' subflow__track--open'}`}
                      aria-hidden="true"
                      style={`--lv:${levelIndex(p.activity)}`}
                    >
                      <span class="subflow__fill" />
                    </span>
                  </span>
                )}
              </button>
              {(p.activity.activities?.length ?? 0) > 0 && (
                <button class="subflow__expand" data-expand={p.activity.id} aria-expanded="false">
                  ▸ {p.activity.activities!.length} inside
                </button>
              )}
              {(p.activity.activities?.length ?? 0) > 0 && (
                <div class="subflow__nest" data-subflow-panel={p.activity.id} hidden>
                  <Astro.self team={team} activities={p.activity.activities!} />
                </div>
              )}
            </>
          ))}
          {echoes(r.id, c).map((p) => (
            <button
              class="subflow__echo"
              data-act={p.activity.id}
              data-fills={p.activity.tooling?.tool}
              data-roles={p.activity.roles.join(' ')}
              data-depth="sub"
              aria-label={`${p.activity.name} — shared with ${r.name}, card in the ${roleName(p.activity.roles[0]!)} lane — details`}
            >
              {p.activity.name}
            </button>
          ))}
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  /* One grid for the whole inset, not one per lane: `max-content` resolves against
     whatever a single grid holds, so per-row grids size step 1 to a lane's own
     widest box and the same step lands at a different x in every lane. The rows
     inherit the tracks through `subgrid` and keep their own border and padding. */
  .subflow {
    display: grid;
    grid-template-columns: 92px repeat(var(--subcols), minmax(116px, max-content));
    column-gap: 6px;
  }
  .subflow__row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    gap: 6px;
    padding: 6px 0;
    align-items: start;
    transition: opacity 0.28s var(--ease-out);
  }
  .subflow__row + .subflow__row {
    border-top: 1px solid var(--line);
  }
  .subflow__role {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
    padding-top: 8px;
  }
  .subflow__cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
  }
  .subflow__act {
    background: var(--white);
    border: 1px solid var(--ink);
    padding: 6px 7px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    transition: background 0.12s ease-out, color 0.12s ease-out, opacity 0.28s var(--ease-out);
  }
  .subflow__act:hover {
    background: var(--washi);
  }
  .subflow__act--open {
    border-style: dashed;
    border-color: var(--muted);
    background-color: var(--washi);
    background-image: var(--stripe);
  }
  .subflow__act--open:hover {
    border-color: var(--ink);
  }
  .subflow__act--open .subflow__level {
    color: var(--accent);
    font-weight: 700;
  }
  /* Same selection mark as the parent flow: an ink invert keeping the green spine.
     The background shorthand clears the open slot's stripe, so a selected open slot
     sheds what ink cannot carry. */
  .subflow__act[aria-current='true'] {
    background: var(--ink);
    border: 1px solid var(--ink);
    border-left: 2px solid var(--accent);
    color: var(--white);
  }
  .subflow__act[aria-current='true'] .subflow__level {
    color: var(--muted);
  }
  .subflow__name {
    font-size: var(--label);
    line-height: 12px;
    font-weight: 700;
  }
  /* The parent card's level ramp, unchanged: the word answers "which level", the
     2px track answers "how far along" — one activity must state its level the
     same way at every depth it is drawn. */
  .subflow__level {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1;
    font-size: 8px;
    letter-spacing: 0.08em;
    color: var(--sub);
  }
  .subflow__track {
    height: 2px;
    background: var(--line);
  }
  .subflow__fill {
    display: block;
    height: 100%;
    width: calc((var(--lv) + 1) / 4 * 100%);
    background: var(--accent);
  }
  .subflow__track--open .subflow__fill {
    width: 0;
  }
  .subflow__act[aria-current='true'] .subflow__track {
    background: rgba(255, 255, 255, 0.25);
  }
  .subflow__act[aria-current='true'] .subflow__fill {
    background: var(--accent-on-ink);
  }
  /* The parent figure's echo skin, at the inset's scale: a hairline box rather
     than the card's ink border, because the border weight is what separates work
     drawn here from work drawn elsewhere. Not the dashed open-slot skin — that
     states the team declared a gap, and a shared activity has declared nothing. */
  .subflow__echo {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 5px 7px;
    text-align: left;
    width: 100%;
    font-size: var(--micro);
    line-height: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--sub);
    transition: background 0.12s ease-out, color 0.12s ease-out,
      border-color 0.12s ease-out, opacity 0.28s var(--ease-out);
  }
  .subflow__echo:hover {
    background: var(--washi);
    border-color: var(--ink);
    color: var(--ink);
  }
  .subflow__echo[aria-current='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .subflow__expand {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 2px 0;
  }
  .subflow__expand[aria-expanded='true'] {
    color: var(--ink);
  }
  .subflow__nest {
    border-left: 2px solid var(--accent);
    padding-left: 8px;
    margin-top: 2px;
  }
</style>
