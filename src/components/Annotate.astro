---
// The annotation layer — see `_plans/spec-annotations.md`.
//
// `Layout` renders this behind `import.meta.env.DEV`, so it exists on a served
// page and nowhere else: the exported single file has no server to write to, so
// it carries no way to write (D-ANN-5).
//
// Press `a` to arm, click a node, write a sentence. The mode is one note long —
// submitting leaves it — because the fast path this exists for is "that node
// there is wrong", not a review session.
import { MAX_NOTE } from '../lib/anchor';
---

<!-- The armed mode, said at the edge of the screen. It is the one state that
     changes what a click means everywhere at once, so it is stated everywhere
     at once rather than in a corner the reader's eye has already left. Inert to
     the pointer — the whole page underneath stays clickable, which is the point
     of the mode. -->
<div class="ann__frame" data-ann-frame aria-hidden="true"></div>

<div class="ann" data-ann>
  <div class="ann__bar" data-ann-bar>
    <span class="tab">ANNOTATE</span>
    <span class="ann__hint" data-ann-hint>click anything · esc to leave</span>
  </div>
</div>

<!-- Outside the bar, because it is placed against the node it is about rather
     than against a corner. It carries `data-ann` of its own so a click inside
     it is still a click on the layer, not on the page. -->
<form class="module ann__composer" data-ann data-ann-composer hidden>
  <div class="module__head">
    <span class="module__title ann__anchor" data-ann-anchor></span>
    <button type="button" class="drawer-ctl ann__new" data-ann-new hidden>+ NEW NOTE</button>
    <button type="button" class="drawer-ctl" data-ann-cancel aria-label="Cancel">✕</button>
  </div>
  <div class="ann__prior" data-ann-prior hidden></div>
  <textarea
    class="ann__text"
    data-ann-text
    rows="4"
    placeholder="What is wrong, missing, or unclear here?"
    maxlength={MAX_NOTE}></textarea>
  <div class="ann__foot">
    <span class="panel-label ann__note" data-ann-status></span>
    <button type="submit" class="chip chip--inverse ann__save">SAVE</button>
  </div>
</form>

<style>
  /* The bar sits in the one corner nothing else claims: the drawer takes the
     right edge, the impeccable live bar the bottom center. One flag puts it
     there — the body attribute that arms the mode is also what shows it, so
     there is no second piece of visibility state to keep in step.
     The 14px seam is the constraint chip's, in the opposite corner: this world
     has one inset for a panel that floats over a figure, and a bar run into the
     corner instead reads as a strip the viewport cut off rather than a panel. */
  .ann {
    display: none;
    position: fixed;
    left: 14px;
    bottom: 14px;
    z-index: 90;
    font-family: var(--font);
  }

  :global(body[data-annotate]) .ann {
    display: block;
  }

  /* The mode frame. A 2px signal-green ring with the accent bleeding inward —
     the one sanctioned glow outside the sub-process halo, and functional for
     the same reason that one is: it is not lifting a surface, it is saying the
     page itself is in a state. Green because that is this world's signal ink,
     and it is drawn on nothing, so the ban on green as a fill still holds.
     Inset rather than outset: an outer glow on a fixed frame has nowhere to
     fall, and would only clip against the viewport edge. */
  .ann__frame {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 89;
    pointer-events: none;
    border: 2px solid var(--accent);
  }

  /* The glow breathes on its own layer, and by opacity alone: animating the
     shadow itself repaints the whole frame every frame, while an opacity fade
     on a pseudo-element the compositor already holds costs nothing. Slow —
     2.4s, and the ring underneath never goes out — because this runs for as
     long as the mode is on, behind a reader who is trying to read. A blink
     would be a countdown; this is a pilot light. */
  .ann__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    /* The haze alone. The ring is the element's own border, already solid and
       already full strength — a second ring at the same inset would be the
       static one breathing over itself. */
    box-shadow: inset 0 0 44px rgba(15, 107, 60, 0.5);
    animation: ann-breathe 2.4s ease-in-out infinite alternate;
  }

  @keyframes ann-breathe {
    from {
      opacity: 0.1;
    }
    to {
      opacity: 1;
    }
  }

  /* The frame is fully legible standing still, which is what this world asks of
     a state — so the motion is the part that goes, not the signal. */
  @media (prefers-reduced-motion: reduce) {
    .ann__frame::after {
      animation: none;
      opacity: 1;
    }
  }

  :global(body[data-annotate]) .ann__frame {
    display: block;
  }

  /* The masthead switch, lit. It reads the body flag rather than its own
     `aria-pressed` so the mode has one source of truth for its look and
     `aria-pressed` stays what it is — the announcement, which CSS cannot make
     and a selector should not depend on. The rule lives here because this file
     is the one the layout gates: a scoped rule in the button's own component
     would ship into a built page the button is absent from. */
  :global(body[data-annotate] [data-ann-toggle]) {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* `display` on the element beats the UA rule for `[hidden]`, and the composer
     is flex — without this it never visibly closes. */
  .ann__composer[hidden] {
    display: none;
  }

  /* A module head that happens to float: tab seated in an even gutter, ink
     ground, and the 1px border the Shadowless Rule gives a layer that has to
     separate from what it sits over. The border is the frame's green and the
     glow is the frame's glow, so the bar reads as the lit edge's label rather
     than as a second piece of chrome that happens to be on at the same time. */
  .ann__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px 5px 5px;
    /* The same cap the constraint chip takes in the opposite corner: on a phone
       the hint wraps to a second line rather than running off the edge, which
       is the truncation this bar is meant not to read as. */
    max-width: calc(100vw - 28px);
    background: var(--ink);
    border: 1px solid var(--accent);
    box-shadow: 0 0 14px rgba(15, 107, 60, 0.3);
    color: var(--white);
    font-size: var(--label);
    letter-spacing: 0.08em;
  }

  .ann__hint {
    color: var(--muted);
    text-transform: uppercase;
  }

  /* Placed by the script against the clicked node, so the sentence and its
     subject are read in one glance. `top`/`left` start off-screen: the card is
     measured before it is placed, and a first frame at the corner would read
     as a jump. */
  /* A `.module` that floats: the chrome is the drawers' chrome, and only the
     placing and the border are its own. Ink rather than the module hairline
     because this one sits over the figure instead of inside the page. */
  .ann__composer {
    position: fixed;
    top: -9999px;
    left: -9999px;
    z-index: 91;
    width: min(360px, 96vw);
    border-color: var(--ink);
    display: flex;
    flex-direction: column;
    font-family: var(--font);
  }

  /* The name takes the room the two controls do not. */
  .ann__anchor {
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Shown only while an existing note is open, which is the only moment the
     reader needs to say "not that one — another". */
  .ann__new {
    white-space: nowrap;
  }

  /* Notes already on this node, so the reader does not say a second time what
     the folder already holds. Read-only here: resolving is a CLI verb (D-ANN-12). */
  .ann__prior {
    max-height: 96px;
    overflow-y: auto;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    font-size: var(--body);
    color: var(--sub);
  }

  .ann__prior p {
    margin: 0 0 4px;
  }

  .ann__prior p:last-child {
    margin-bottom: 0;
  }

  .ann__prior b {
    color: var(--ink);
    font-weight: 600;
  }

  .ann__text {
    border: 0;
    padding: 8px;
    font: inherit;
    font-size: var(--prose);
    line-height: 18px;
    color: var(--ink);
    resize: vertical;
  }

  .ann__text:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .ann__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 8px;
    border-top: 1px solid var(--line);
  }

  /* A label in a row, not above a block. */
  .ann__note {
    margin-bottom: 0;
  }

  .ann__save {
    padding: 4px 12px;
  }

  .ann__save:disabled {
    background: var(--white);
    color: var(--muted);
    border-color: var(--line);
    cursor: default;
  }

  /* The save button is a chip, and `.chip` is `inline-block` — the foot lays
     both children out itself. */
  .ann__foot .ann__save {
    flex: 0 0 auto;
  }

  /* Marks live only while the mode is on (D-ANN-11): by default the figure is
     exactly what it was, and a note is not a property of the process. */

  /* Every node on the page sets its own `cursor: pointer`, which beats a cursor
     on `<body>` — so the mode read as normal browsing over exactly the nodes it
     is about. The universal selector is what makes one mode one cursor. */
  :global(body[data-annotate]),
  :global(body[data-annotate] *) {
    cursor: crosshair;
  }

  /* Both addressing schemes, or the activity cards — the thing a reader clicks
     first — are the one part of the figure the mode does not light up. */
  :global(body[data-annotate] [data-detail-key]:hover),
  :global(body[data-annotate] [data-act]:hover) {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    background: rgba(15, 107, 60, 0.07);
  }

  /* Already said. Dashed, so what carries a note and what is merely under the
     pointer never read as the same state. */
  :global(body[data-annotate] [data-ann-marked]) {
    outline: 2px dashed var(--ink);
    outline-offset: 1px;
  }

  /* The node the open composer is about. It outranks hover and mark because
     while a note is being written there is one subject on the page, and losing
     sight of it is losing the sentence. */
  :global(body[data-annotate] [data-ann-target]),
  :global(body[data-annotate] [data-ann-target]:hover) {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
    background: rgba(15, 107, 60, 0.12);
  }

  /* `[data-ann]`, not `.ann`: the bar and the floating card are two roots, and
     the attribute is what the click handler already treats as "the layer". */
  :global(body[data-annotate] [data-ann]),
  :global(body[data-annotate] [data-ann] *) {
    cursor: auto;
  }

  :global(body[data-annotate] [data-ann] button) {
    cursor: pointer;
  }
</style>

<script>
  // The route and the anchor test, from the module the endpoint reads them
  // from — a client that mints an anchor the server rejects, or posts to a path
  // it does not answer, is the failure a second copy of either would cause.
  import { ANNOTATIONS_ROUTE, isAnchor } from '../lib/anchor';

  interface Annotation {
    id: string;
    anchor: string;
    created: string;
    note: string;
  }

  const composer = document.querySelector<HTMLFormElement>('[data-ann-composer]')!;
  const anchorLabel = composer.querySelector<HTMLElement>('[data-ann-anchor]')!;
  const prior = composer.querySelector<HTMLElement>('[data-ann-prior]')!;
  const text = composer.querySelector<HTMLTextAreaElement>('[data-ann-text]')!;
  const status = composer.querySelector<HTMLElement>('[data-ann-status]')!;
  const save = composer.querySelector<HTMLButtonElement>('[type="submit"]')!;
  const cancel = composer.querySelector<HTMLButtonElement>('[data-ann-cancel]')!;
  const newNote = composer.querySelector<HTMLButtonElement>('[data-ann-new]')!;
  const hint = document.querySelector<HTMLElement>('[data-ann-hint]')!;

  // The endpoint is relative, so a `base` prefix rides along without this
  // knowing what it is.
  const ENDPOINT = new URL(ANNOTATIONS_ROUTE, document.baseURI).href;

  // The body attribute is the mode: one flag, read by the CSS and by the
  // handlers alike, so there is no second copy to keep in step.
  const armed = () => document.body.hasAttribute('data-annotate');

  let target: string | null = null;
  let subject: HTMLElement | null = null;
  // Where the click landed. A note the model has no node for still opens where
  // the reader was looking rather than in a corner.
  let point = { x: 0, y: 0 };
  // The note the composer is rewriting, when the reader opened one that already
  // existed. Null means the save mints a new one.
  let editing: Annotation | null = null;
  let known: Annotation[] = [];

  // The document the click landed in. On the exported route several documents
  // share a page, so this is read from the click rather than from the page.
  const docAnchor = (from: Element | null) => {
    const doc = from?.closest<HTMLElement>('[data-doc]');
    const name = doc?.dataset.doc;
    return !name || name === '__team' ? 'team' : `process:${name}`;
  };

  // Three ways the page names the same entry, the same three `ProcessDoc`
  // selects on: an activity card by `data-act`, a playbook tool button by
  // `data-tool`, and everything else — roles, artifacts, drawer links — by a
  // `kind:id` in `data-detail-key`. Reading fewer than all three files a note
  // against the whole document while the reader is pointing at a node.
  const ADDRESSED = '[data-detail-key], [data-act], [data-tool]';

  const keyOf = (node: HTMLElement | null) => {
    if (node?.dataset.act) return `activity:${node.dataset.act}`;
    if (node?.dataset.tool) return `tool:${node.dataset.tool}`;
    const key = node?.dataset.detailKey;
    // A bare `data-detail-key` is an activity id; a prefixed one already names
    // its kind. `__`-prefixed keys are the drawer's own panels (`__process`,
    // `__open`), not nodes in the model.
    return !key || key.startsWith('__') ? null : key.includes(':') ? key : `activity:${key}`;
  };

  // Best-effort resolution (D-ANN-3): the click walks up to the nearest thing
  // the model actually names, and a click that names nothing is a note about the
  // document it landed in (D-ANN-7). No precision is asked of the reader.
  function subjectAt(el: Element | null): { anchor: string; node: HTMLElement | null } {
    const node = el?.closest<HTMLElement>(ADDRESSED) ?? null;
    const key = keyOf(node);
    // The same predicate the endpoint answers 400 with: a key the model does
    // not name — a drawer route like `open:feature` — is a note about the page.
    return { anchor: key && isAnchor(key) ? key : docAnchor(el), node };
  }

  // The reverse trip, for marking. One pass over everything the page addresses,
  // asked the same question `subjectAt` asks — so a node that can be annotated
  // is exactly a node that can be marked, with no second mapping to keep in
  // step. `team` and `process:` name a whole document, which has no node.
  function mark() {
    for (const el of document.querySelectorAll('[data-ann-marked]')) el.removeAttribute('data-ann-marked');
    const anchors = new Set(known.map((a) => a.anchor));
    if (!anchors.size) return;
    for (const el of document.querySelectorAll<HTMLElement>(ADDRESSED)) {
      const key = keyOf(el);
      if (key && anchors.has(key)) el.setAttribute('data-ann-marked', '');
    }
  }

  const label = (anchor: string) => (anchor === 'team' ? 'THE DOCUMENT' : anchor.replace(':', ' · '));

  async function load() {
    try {
      const res = await fetch(ENDPOINT, { headers: { accept: 'application/json' } });
      known = res.ok ? ((await res.json()).annotations ?? []) : [];
      hint.textContent = known.length
        ? `click anything · ${known.length} open · esc to leave`
        : 'click anything · esc to leave';
    } catch {
      // Serving a built file, or the dev server is gone: the mode still captures,
      // and the save is where the failure has to be told.
      known = [];
    }
    mark();
  }

  // One switch per document, and the export puts several documents in one file —
  // so the pressed state is written to all of them, not to the one that was
  // clicked. The mode is a property of the page.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-ann-toggle]');
  const showArmed = (on: boolean) => {
    for (const t of toggles) t.setAttribute('aria-pressed', String(on));
  };

  function arm() {
    document.body.setAttribute('data-annotate', '');
    showArmed(true);
    void load();
  }

  function disarm() {
    document.body.removeAttribute('data-annotate');
    showArmed(false);
    closeComposer();
    // Leaving takes the marks with it, so the next arming draws what the folder
    // holds then rather than what it held before.
    known = [];
    mark();
  }

  // Beside the node, on whichever side has room. The card is fixed, the node
  // scrolls, so this runs again on every scroll and resize while the composer
  // is open — a card left behind by a scroll is worse than one in a corner.
  const GAP = 10;
  const EDGE = 12;

  function place() {
    if (composer.hidden) return;
    const w = composer.offsetWidth;
    const h = composer.offsetHeight;
    const vw = window.innerWidth;
    const vh = window.innerHeight;

    // Either drawer owns the right edge while it is open, and a card under one
    // is a card the reader cannot finish reading.
    const drawer = document.querySelector('[data-drawer]:not([hidden])')?.getBoundingClientRect();
    const right = drawer ? Math.min(vw - EDGE, drawer.left - GAP) : vw - EDGE;

    // A click on lane background names no node, but it still names a place —
    // the pointer becomes a box of no size, so one rule places both cases.
    const box = subject?.getBoundingClientRect() ?? new DOMRect(point.x, point.y, 0, 0);

    let left = box.right + GAP;
    if (left + w > right) left = box.left - GAP - w;
    if (left < EDGE) left = Math.min(Math.max(EDGE, box.left), right - w);

    composer.style.left = `${Math.max(EDGE, Math.min(left, right - w))}px`;
    composer.style.top = `${Math.max(EDGE, Math.min(box.top, vh - EDGE - h))}px`;
  }

  // Scroll events arrive faster than frames, and each `place()` reads layout
  // and then writes it — so unthrottled, one flick pays several reflows for one
  // visible move. A scroll inside the card itself moves nothing and is dropped.
  let pending = false;
  const reposition = (e: Event) => {
    if (pending || (e.target as Element | null)?.closest?.('[data-ann]')) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      place();
    });
  };

  const SCROLL = { capture: true, passive: true } as const;

  // The head says which note is open, the list says what else this node already
  // carries. Everything but the one being edited, or the reader reads their own
  // sentence twice.
  function showPrior() {
    const head = target ? label(target) : '';
    anchorLabel.textContent = editing ? `${head} · ${editing.id}` : head;
    newNote.hidden = !editing;
    const rest = known.filter((a) => a.anchor === target && a.id !== editing?.id);
    prior.hidden = rest.length === 0;
    prior.replaceChildren(
      ...rest.map((a) => {
        const p = document.createElement('p');
        const id = document.createElement('b');
        id.textContent = `${a.id} `;
        p.append(id, a.note);
        return p;
      })
    );
  }

  function closeComposer() {
    composer.hidden = true;
    window.removeEventListener('scroll', reposition, SCROLL);
    window.removeEventListener('resize', reposition);
    target = null;
    subject = null;
    editing = null;
    newNote.hidden = true;
    text.value = '';
    status.textContent = '';
    save.disabled = false;
    for (const el of document.querySelectorAll('[data-ann-target]')) el.removeAttribute('data-ann-target');
  }

  function openComposer(anchor: string, on: HTMLElement | null, at: { x: number; y: number }) {
    closeComposer();
    target = anchor;
    subject = on;
    point = at;
    // The clicked element alone, not every twin the anchor marks: the subject of
    // the sentence being written is the node the reader is looking at.
    on?.setAttribute('data-ann-target', '');
    // A marked node already carries a sentence, and the reader who clicks it is
    // almost always coming back to that sentence — so the note opens, rather
    // than an empty box beside a note they then say twice. The newest is the
    // one opened; the rest stay listed above it, and `+ NEW NOTE` is the way
    // out to a blank one.
    const existing = known.filter((a) => a.anchor === anchor);
    editing = existing[existing.length - 1] ?? null;
    text.value = editing?.note ?? '';
    showPrior();
    composer.hidden = false;
    place();
    // Capture, so a scroll inside the drawer or any other scroller moves the
    // card with the node it is about — those do not bubble.
    window.addEventListener('scroll', reposition, SCROLL);
    window.addEventListener('resize', reposition, { passive: true });
    text.focus();
  }

  // Capture, because in normal mode this same click drills into the drawer —
  // arming the mode is what makes the click mean something else.
  document.addEventListener(
    'click',
    (e) => {
      if (!armed()) return;
      const el = e.target as Element | null;
      if (el?.closest('[data-ann]')) return;
      e.preventDefault();
      e.stopPropagation();
      const { anchor, node } = subjectAt(el);
      openComposer(anchor, node, { x: e.clientX, y: e.clientY });
    },
    true
  );

  document.addEventListener(
    'keydown',
    (e) => {
      if (e.key === 'Escape' && armed()) {
        // Swallowed, or the same Escape closes the drawer on the way out.
        e.stopPropagation();
        if (!composer.hidden) closeComposer();
        else disarm();
        return;
      }
      if (e.key !== 'a' && e.key !== 'A') return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      // The composer is the only text input the page has, and the letter that
      // arms the mode has to stay a letter inside it.
      const el = e.target as HTMLElement | null;
      if (el instanceof HTMLTextAreaElement || el instanceof HTMLInputElement || el?.isContentEditable) return;
      e.preventDefault();
      armed() ? disarm() : arm();
    },
    true
  );

  for (const t of toggles) t.addEventListener('click', () => (armed() ? disarm() : arm()));

  cancel.addEventListener('click', closeComposer);

  newNote.addEventListener('click', () => {
    editing = null;
    text.value = '';
    showPrior();
    place();
    text.focus();
  });

  composer.addEventListener('submit', async (e) => {
    e.preventDefault();
    const note = text.value.trim();
    if (!note || !target) return;
    save.disabled = true;
    status.textContent = 'saving…';
    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ anchor: target, note, id: editing?.id }),
      });
      if (!res.ok) throw new Error(((await res.json()) as { error?: string }).error ?? `HTTP ${res.status}`);
      // One arming is one note: the mode leaves with the note (D-ANN-3).
      disarm();
    } catch (err) {
      status.textContent = (err as Error).message;
      save.disabled = false;
    }
  });
</script>
