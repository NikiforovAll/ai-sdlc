---
import type { Team } from '../lib/derive';
import { flatten, isLinkableRef, LEVEL_LABELS, LEVEL_NOTES, LEVEL_ORDER, nameOf, statesCapability, toolOf, toolsOfHarness, usesOfTool } from '../lib/derive';
import { catalogDescriptions, md, paragraphs } from '../lib/markdown';
import { VERB } from '../lib/docs';

interface Props {
  team: Team;
  /** The process itself is a drawer panel: its name opens from the masthead line. */
  process?: {
    name: string;
    note?: string;
    description?: string;
    refs?: string[];
    stages: number;
    activities: number;
    file?: string;
  };
}
const { team, process } = Astro.props;
const flat = flatten(team);

const artifactName = (id: string) => nameOf(team.artifacts, id);
const roleName = (id: string) => nameOf(team.roles, id);
const stageName = (id: string) => nameOf(team.stages, id);
const harnessName = (id: string) => nameOf(team.harnesses, id);
const eventName = (id: string) => nameOf(team.events, id);
const activityLabel = (id: string) => flat.find((f) => f.activity.id === id)?.activity.name ?? id;
const producerOf = (art: string) => flat.find((f) => f.activity.produces.includes(art));
const consumersOf = (art: string) => flat.filter((f) => (f.activity.consumes ?? []).includes(art));

// Every catalog description is rendered once here rather than per panel: the
// processor is async and the panels are a static map, so the render belongs in
// frontmatter where the cost is paid at build time.
const descriptions = await catalogDescriptions(team);
// The process's own long form is not a catalog entry, so it renders on its own —
// same treatment, one document up.
const processProse = process?.description ? await md(process.description) : null;

const actsOfRole = (r: string) => flat.filter((f) => f.activity.roles.includes(r));
// An event is named by recommendations, never by a fill: it says when a tool is
// reached for, so its panel is the list of those moments.
const recsOfEvent = (ev: string) =>
  flat.flatMap((f) =>
    (f.activity.recommends ?? []).filter((r) => r.event === ev).map((rec) => ({ activity: f.activity, rec }))
  );
---

<!-- Addressed by attribute, not id: the export puts one drawer per process document
     in a single file, and an id can only name one of them. -->
<aside class="drawer" data-drawer hidden aria-label="Detail drawer">
  <div class="module__head drawer__head">
    <span class="tab">DETAIL</span>
    <span class="module__title">Drill-Down</span>
    <button class="drawer-ctl drawer-ctl--back" data-drawer-back hidden aria-label="Back to the previous entry">← BACK</button>
    <button class="drawer-ctl drawer-ctl--close" data-drawer-close aria-label="Close detail drawer">CLOSE ✕</button>
  </div>

  <div class="drawer__body">
    {process && (
      <div class="drawer__panel" data-detail="__process" hidden>
        <div class="drawer__title-row">
          <h3 class="drawer__name drawer__name--doc">{process.name}</h3>
        </div>
        <div class="drawer__chips">
          <span class="chip chip--inverse">{process.activities} ACTIVITIES</span>
          <span class="chip">{process.stages} STAGES</span>
        </div>

        {(process.note || processProse) && (
          <div class="drawer__section">
            <h4 class="drawer__label">About</h4>
            {process.note && <p class="drawer__why">{process.note}</p>}
            {processProse && <div class="drawer__prose prose-md" set:html={processProse} />}
          </div>
        )}

        {(process.refs ?? []).length > 0 && (
          <div class="drawer__section">
            <h4 class="drawer__label">Read from</h4>
            <ul class="drawer__refs">
              {process.refs!.map((ref) => (
                <li>{isLinkableRef(ref) ? <a href={ref} target="_blank" rel="noreferrer">{ref}</a> : ref}</li>
              ))}
            </ul>
          </div>
        )}

        {process.file && (
          <div class="drawer__section">
            <h4 class="drawer__label">Source</h4>
            <p class="drawer__tool-line">{process.file}</p>
            <p class="drawer__none">
              One file is one process. The page has no write path — the editor is the editor.
            </p>
          </div>
        )}
      </div>
    )}

    {flat.map(({ activity: a, stage, parent, depth }) => (
      <div class="drawer__panel" data-detail={a.id} hidden>
        {parent && (
          <p class="drawer__crumb">
            {depth > 1 ? '… → ' : ''}inside <strong>{parent.name}</strong>
          </p>
        )}
        <div class="drawer__title-row">
          <h3 class="drawer__name">{a.name}</h3>
        </div>
        <div class="drawer__chips">
          <span class="chip chip--inverse">{stageName(stage)}</span>
          {a.roles.map((r) => (
            <button class="chip chip--link" data-detail-key={`role:${r}`}>{roleName(r)}</button>
          ))}
        </div>
        {a.why && <p class="drawer__why">{a.why}</p>}

        <div class="drawer__section">
          <h4 class="drawer__label">Consumes</h4>
          {(a.consumes ?? []).length ? (
            <ul class="drawer__list">
              {(a.consumes ?? []).map((art) => {
                const from = producerOf(art);
                const handoff = from && !from.activity.roles.some((r) => a.roles.includes(r));
                return (
                  <li>
                    <button class="drawer__artifact drawer__link" data-detail-key={`artifact:${art}`}>{artifactName(art)}</button>
                    {from && (
                      <span class="drawer__via">
                        ← <button class="drawer__link" data-detail-key={from.activity.id}>{from.activity.name}</button>
                        {handoff && <span class="drawer__handoff"> · handoff</span>}
                        {team.constraint?.artifact === art && <span class="drawer__one"> ①</span>}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="drawer__none">Nothing — this is a source activity.</p>
          )}
        </div>

        <div class="drawer__section">
          <h4 class="drawer__label">Produces</h4>
          <ul class="drawer__list">
            {a.produces.map((art) => {
              const consumers = consumersOf(art).filter((c) => c.activity.id !== a.id);
              return (
                <li>
                  <button class="drawer__artifact drawer__link" data-detail-key={`artifact:${art}`}>{artifactName(art)}</button>
                  {consumers.length > 0 ? (
                    <span class="drawer__via">
                      {/* The separator sits inside the map with no newline before the
                          button: a line break between two JSX expressions renders as a
                          space, which put a gap in front of every comma. */}
                      → {consumers.map((c, i) => (
                        <>{i > 0 ? ', ' : ''}<button class="drawer__link" data-detail-key={c.activity.id}>{c.activity.name}</button></>
                      ))}
                      {team.constraint?.artifact === art && <span class="drawer__one"> ①</span>}
                    </span>
                  ) : (
                    <span class="drawer__via">→ leaves the process</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>

        {/* Three states. The section is drawn for the two the team has said
            something about; an activity that is neither filled nor declared open
            has nothing to report here, and a TOOLING head over a shrug was the
            page asserting a gap the team never claimed. */}
        {statesCapability(a) && (
        <div class="drawer__section">
          <h4 class="drawer__label">Tooling</h4>
          {a.tooling ? (
            <div class="drawer__tooling">
              <p class="drawer__tool-line">
                <button class="drawer__artifact drawer__link" data-detail-key={`harness:${toolOf(team, a.tooling.tool).harness}`}>{harnessName(toolOf(team, a.tooling.tool).harness)}</button>
                <span class="drawer__artifact"> · </span>
                <button class="drawer__artifact drawer__link" data-detail-key={`tool:${a.tooling.tool}`}>{toolOf(team, a.tooling.tool).name}</button>
                {a.tooling.asset && <span class="drawer__via"> · {a.tooling.asset}</span>}
              </p>
              <div class="drawer__ladder">
                <span class="chip">{LEVEL_LABELS[a.tooling.level]}</span>
                <span class="drawer__ladder-steps" aria-hidden="true">
                  {LEVEL_ORDER.map((step) => (
                    <span
                      class={`drawer__ladder-step${
                        LEVEL_ORDER.indexOf(a.tooling!.level) >= LEVEL_ORDER.indexOf(step)
                          ? ' drawer__ladder-step--on'
                          : ''
                      }`}
                    />
                  ))}
                </span>
                <span class="drawer__ladder-loop">{LEVEL_NOTES[a.tooling.level].loop}</span>
              </div>
              <p class="drawer__ladder-note">{LEVEL_NOTES[a.tooling.level].note}</p>
              {a.tooling.usage && paragraphs(a.tooling.usage).map((t) => <span class="drawer__usage">{t}</span>)}
              {(a.tooling.refs ?? []).length > 0 && (
                <ul class="drawer__refs">
                  {a.tooling.refs!.map((ref) => (
                    <li>{isLinkableRef(ref) ? <a href={ref} target="_blank" rel="noreferrer">{ref}</a> : ref}</li>
                  ))}
                </ul>
              )}
            </div>
          ) : (
            <div>
              <span class="drawer__open-mark">OPEN SLOT</span>
              {/* The team's own words about what would fill it. That sentence is
                  the whole reason the slot is declared rather than inferred, so
                  it is the content here — not a house line about roadmaps. */}
              {paragraphs(a.open!.need).map((t) => <p class="drawer__open-need">{t}</p>)}
            </div>
          )}
        </div>
        )}

        {(a.activities?.length ?? 0) > 0 && (
          <div class="drawer__section">
            <h4 class="drawer__label">Sub-process</h4>
            <ul class="drawer__list">
              {a.activities!.map((c) => (
                <li>
                  <button class="drawer__artifact drawer__link" data-detail-key={c.id}>{c.name}</button>
                  <span class="drawer__via">
                    {c.tooling ? (
                      <>
                        <button class="drawer__via drawer__link" data-detail-key={`harness:${toolOf(team, c.tooling.tool).harness}`}>{harnessName(toolOf(team, c.tooling.tool).harness)}</button>
                        {' · '}
                        <button class="drawer__via drawer__link" data-detail-key={`tool:${c.tooling.tool}`}>{toolOf(team, c.tooling.tool).name}</button>
                      </>
                    ) : c.open ? ' open slot' : ''}
                  </span>
                </li>
              ))}
            </ul>
            <p class="drawer__none">Expand ▸ in the flow view to see it as a swimlane.</p>
          </div>
        )}

        {(a.recommends ?? []).length > 0 && (
          <div class="drawer__section">
            <h4 class="drawer__label">Recommended tooling here</h4>
            <ul class="drawer__list">
              {(a.recommends ?? []).map((r) => (
                <li>
                  <button class="drawer__artifact drawer__link" data-detail-key={`tool:${r.tool}`}>{toolOf(team, r.tool).name}</button>
                  <button class="drawer__via drawer__link" data-detail-key={`harness:${toolOf(team, r.tool).harness}`}>{harnessName(toolOf(team, r.tool).harness)}</button>
                  {r.level && <span class="drawer__via"> · {LEVEL_LABELS[r.level]}</span>}
                  {r.event && (
                    <button class="drawer__event drawer__link" data-detail-key={`event:${r.event}`}> <svg class="drawer__bolt" viewBox="0 0 8 10" aria-hidden="true"><path d="M4.6 0 1 5.6h2.3L2.7 10 7 4.2H4.4Z" fill="currentColor" /></svg>{eventName(r.event)}</button>
                  )}
                  {r.usage && paragraphs(r.usage).map((t) => <span class="drawer__usage">{t}</span>)}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    ))}

    {team.tools.map((s) => {
      const uses = usesOfTool(team, s.id);
      return (
      <div class="drawer__panel" data-detail={`tool:${s.id}`} hidden>
        <div class="drawer__title-row">
          <h3 class="drawer__name">{s.name}</h3>
        </div>
        <div class="drawer__chips">
          <button class="chip chip--inverse chip--link" data-detail-key={`harness:${s.harness}`}>{harnessName(s.harness)}</button>
          {[...new Set(uses.flatMap((u) => u.activity.roles))].map((r) => (
            <button class="chip chip--link" data-detail-key={`role:${r}`}>{roleName(r)}</button>
          ))}
        </div>
        <p class="drawer__why">{s.kind}</p>
        {s.note && <p class="drawer__why">{s.note}</p>}
        {descriptions.has(`tool:${s.id}`) && (
          <div class="drawer__prose prose-md" set:html={descriptions.get(`tool:${s.id}`)} />
        )}

        <div class="drawer__section">
          <h4 class="drawer__label">Reached for</h4>
          <ul class="drawer__list">
            {uses.map(({ activity, rec }) => (
              <li>
                {rec?.event && (
                  <button class="drawer__event drawer__link" data-detail-key={`event:${rec.event}`}><svg class="drawer__bolt" viewBox="0 0 8 10" aria-hidden="true"><path d="M4.6 0 1 5.6h2.3L2.7 10 7 4.2H4.4Z" fill="currentColor" /></svg>{eventName(rec.event)}</button><span class="drawer__via"> · </span>
                )}
                <span class="drawer__via">
                  {/* "fills" alone leaves the reader to guess what is being filled,
                      and the name beside it can read as an artifact. The slot is the
                      activity's — the same slot the drawer calls an OPEN SLOT when
                      nothing occupies it. */}
                  {VERB[rec ? 'recommended' : 'fill']}{' '}
                  <button class="drawer__link drawer__here" data-detail-key={activity.id}>{activityLabel(activity.id)}</button>
                </span>
                {rec?.usage && paragraphs(rec.usage).map((t) => <span class="drawer__usage">{t}</span>)}
              </li>
            ))}
          </ul>
        </div>

        {(s.refs ?? []).length > 0 && (
          <div class="drawer__section">
            <h4 class="drawer__label">Refs</h4>
            <ul class="drawer__refs">
              {s.refs!.map((ref) => (
                <li>{isLinkableRef(ref) ? <a href={ref} target="_blank" rel="noreferrer">{ref}</a> : ref}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
      );
    })}

    {/* An artifact is the whole reason the flow has a shape — the layering is
        computed from it — but until now it was only a label on an edge. Its panel
        answers the two questions the edge cannot: what it is, and its full chain. */}
    {team.artifacts.map((art) => {
      const producers = flat.filter((f) => f.activity.produces.includes(art.id));
      const consumers = consumersOf(art.id);
      const isConstraint = team.constraint?.artifact === art.id;
      return (
        <div class="drawer__panel" data-detail={`artifact:${art.id}`} hidden>
          <div class="drawer__title-row">
            <h3 class="drawer__name">{art.name}</h3>
          </div>
          <div class="drawer__chips">
            <span class="chip chip--inverse">ARTIFACT</span>
            {isConstraint && <span class="chip">① THE CONSTRAINT</span>}
          </div>
          {descriptions.has(`artifact:${art.id}`) && (
            <div class="drawer__prose prose-md" set:html={descriptions.get(`artifact:${art.id}`)} />
          )}
          {isConstraint && team.constraint && <p class="drawer__why">{team.constraint.note}</p>}

          <div class="drawer__section">
            <h4 class="drawer__label">Produced by</h4>
            {producers.length ? (
              <ul class="drawer__list">
                {producers.map((f) => (
                  <li>
                    <button class="drawer__link" data-detail-key={f.activity.id}>{f.activity.name}</button>
                    <span class="drawer__via"> {stageName(f.stage)} · {f.activity.roles.map(roleName).join(', ')}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="drawer__none">Nothing in this process — it arrives from outside.</p>
            )}
          </div>

          <div class="drawer__section">
            <h4 class="drawer__label">Consumed by</h4>
            {consumers.length ? (
              <ul class="drawer__list">
                {consumers.map((f) => (
                  <li>
                    <button class="drawer__link" data-detail-key={f.activity.id}>{f.activity.name}</button>
                    <span class="drawer__via"> {stageName(f.stage)} · {f.activity.roles.map(roleName).join(', ')}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="drawer__none">Nobody — it leaves the process here.</p>
            )}
          </div>
        </div>
      );
    })}

    {team.roles.map((r) => {
      const owned = actsOfRole(r.id);
      const filled = owned.filter((f) => f.activity.tooling);
      return (
        <div class="drawer__panel" data-detail={`role:${r.id}`} hidden>
          <div class="drawer__title-row">
            <h3 class="drawer__name">{r.name}</h3>
          </div>
          <div class="drawer__chips">
            <span class="chip chip--inverse">ROLE</span>
            <span class="chip">{owned.length} ACTIVITIES</span>
            <span class="chip">{filled.length} FILLED</span>
          </div>
          {r.note && <p class="drawer__why">{r.note}</p>}
          {descriptions.has(`role:${r.id}`) && (
            <div class="drawer__prose prose-md" set:html={descriptions.get(`role:${r.id}`)} />
          )}

          <div class="drawer__section">
            <h4 class="drawer__label">Owns</h4>
            <ul class="drawer__list">
              {owned.map((f) => (
                <li>
                  <button class="drawer__link" data-detail-key={f.activity.id}>{f.activity.name}</button>
                  <span class="drawer__via">
                    {' '}{stageName(f.stage)}
                    {f.activity.tooling
                      ? ` · ${LEVEL_LABELS[f.activity.tooling.level]}`
                      : f.activity.open
                        ? ' · open slot'
                        : ''}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })}

    {team.harnesses.map((h) => {
      const inside = toolsOfHarness(team, h.id);
      return (
        <div class="drawer__panel" data-detail={`harness:${h.id}`} hidden>
          <div class="drawer__title-row">
            <h3 class="drawer__name">{h.name}</h3>
          </div>
          <div class="drawer__chips">
            <span class="chip chip--inverse">HARNESS</span>
            <span class="chip">{inside.length} TOOLS</span>
          </div>
          {h.note && <p class="drawer__why">{h.note}</p>}
          {descriptions.has(`harness:${h.id}`) && (
            <div class="drawer__prose prose-md" set:html={descriptions.get(`harness:${h.id}`)} />
          )}

          <div class="drawer__section">
            <h4 class="drawer__label">Tools</h4>
            {inside.length ? (
              <ul class="drawer__list">
                {inside.map((t) => (
                  <li>
                    <button class="drawer__link" data-detail-key={`tool:${t.id}`}>{t.name}</button>
                    <span class="drawer__via"> {t.kind} · {usesOfTool(team, t.id).length} uses</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="drawer__none">Nothing on the shelf runs in it yet.</p>
            )}
          </div>
        </div>
      );
    })}

    {team.events.map((ev) => {
      const moments = recsOfEvent(ev.id);
      return (
        <div class="drawer__panel" data-detail={`event:${ev.id}`} hidden>
          <div class="drawer__title-row">
            <h3 class="drawer__name">{ev.name}</h3>
          </div>
          <div class="drawer__chips">
            <span class="chip chip--inverse">EVENT</span>
            <span class="chip">{moments.length} RECOMMENDATIONS</span>
          </div>
          {descriptions.has(`event:${ev.id}`) && (
            <div class="drawer__prose prose-md" set:html={descriptions.get(`event:${ev.id}`)} />
          )}

          <div class="drawer__section">
            <h4 class="drawer__label">Reached for when it happens</h4>
            {moments.length ? (
              <ul class="drawer__list">
                {moments.map(({ activity, rec }) => (
                  <li>
                    <button class="drawer__link" data-detail-key={`tool:${rec.tool}`}>{toolOf(team, rec.tool).name}</button>
                    <span class="drawer__via"> in <button class="drawer__link drawer__here" data-detail-key={activity.id}>{activityLabel(activity.id)}</button></span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="drawer__none">Defined, but nothing is bound to it yet.</p>
            )}
          </div>
        </div>
      );
    })}
  </div>
</aside>

<style>
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--drawer-w);
    background: var(--white);
    border-left: 1px solid var(--ink);
    z-index: 40;
    display: flex;
    flex-direction: column;
  }
  .drawer[hidden] {
    display: none;
  }
  .drawer__head {
    background: var(--white);
  }
  .drawer__body {
    overflow-y: auto;
    padding: 12px;
  }
  .drawer__crumb {
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .drawer__name {
    font-size: var(--subhead);
    line-height: 20px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  /* The document name is a title, not an activity label — uppercase the way the
     team drawer states its own. */
  .drawer__name--doc {
    text-transform: uppercase;
  }
  .drawer__chips {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 7px;
  }
  .drawer__why {
    margin-top: 9px;
    font-size: var(--prose);
    line-height: 20px;
    font-weight: 400;
  }
  .drawer__section {
    border-top: 1px solid var(--line);
    padding-top: 8px;
    margin-top: 12px;
  }
  .drawer__label {
    font-size: var(--micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sub);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .drawer__list {
    list-style: none;
  }
  .drawer__list li + li {
    margin-top: 5px;
  }
  .drawer__artifact {
    font-size: 11px;
    font-weight: 700;
  }
  .drawer__via {
    font-size: var(--label);
    color: var(--sub);
  }
  .drawer__handoff {
    font-weight: 700;
    color: var(--ink);
  }
  .drawer__one {
    color: var(--accent);
    font-weight: 700;
  }
  .drawer__event {
    font-size: var(--label);
    color: var(--accent);
    font-weight: 700;
  }
  .drawer__bolt {
    width: 7px;
    height: 9px;
    margin-right: 2px;
    vertical-align: -1px;
  }
  /* The advice reads as prose under its line, not as another metadata column. */
  /* A name that opens another panel is drawn as the name, not as a link: the
     drawer is a reading surface and a page of underlined blue would read as a
     list of exits. The affordance arrives on hover, where the reader is already
     pointing, and the hairline underline is the same green the rest of the page
     uses for signal. */
  /* No `font: inherit` — the global button reset already does it, and restating
     it here as a class-level shorthand would wipe the size and weight
     `.drawer__artifact` and `.drawer__event` set on the same element. */
  .drawer__link {
    text-align: left;
    border-bottom: 1px solid transparent;
    /* A name inside a sentence stays inside it: as an inline-block the whole
       name would jump to the next line rather than break, leaving a hole in the
       middle of the via-line the panel is 400px wide enough to notice. */
    display: inline;
