---
// The team document: masthead, stat strip, the process index, and the five
// catalogs. A component rather than a page body because the export composes it
// with every process document into one file — `_plans/spec-cli-layer.md`, D-CLI-5.
import TeamDrawer from './TeamDrawer.astro';
import type { OverviewModel, Use } from '../lib/docs';

interface Props {
  model: OverviewModel;
  hidden?: boolean;
  /** Set by the export, where every document shares one file and there are no routes. */
  inline?: boolean;
}
const { model, hidden = false, inline = false } = Astro.props;
const { teamId, team, procs, stats, artifactUse, harnessUse, toolUse, eventUse } = model;

// The href carries the multi-page route; `data-goto` / `data-focus` carry the same
// intent for the single-file export, where there is no route to point at and the
// script answers the click instead.
const useHref = (u: Use) => (inline ? '#' : `/${u.slug}${u.focus ? `#${u.focus}` : ''}`);
const docHref = (slug: string) => (inline ? '#' : `/${slug}`);
---

<section class="doc" data-doc="__team" data-doc-kind="overview" hidden={hidden}>
  <main>
    <header class="mast mast--line module">
      <div class="mast__top">
        <span class="tab">TEAM DOCUMENT</span>
        <h1 class="mast__title">
          <button
            type="button"
            class="mast__open"
            data-open-team
            aria-controls="team-drawer"
            aria-expanded="false"
          >
            {team.name}<span class="mast__open-mark" aria-hidden="true">▸</span>
          </button>
        </h1>
        <span class="mast__status">
          VERSION {team.version} · STATUS <strong class:list={{ 'mast__living': team.status === 'living' }}>{team.status.toUpperCase()}</strong>
        </span>
      </div>

      <dl class="mast__stats">
        {stats.map((s) => (
          <div class="mast__stat">
            <dd class:list={['mast__stat-n', { 'mast__stat-n--open': s.open && s.n > 0 }]}>{s.n}</dd>
            <dt class="mast__stat-label">{s.label}</dt>
          </div>
        ))}
      </dl>
    </header>

    <section class="module" aria-label="Processes">
      <div class="module__head">
        <span class="tab">PROCESSES</span>
        <span class="module__title">Ways Work Flows Through This Team</span>
        <span class="module__meta">one file each · shared catalogs · open a process to read its figures</span>
      </div>
      <ul class="procs">
        {procs.map((p) => (
          <li class="proc">
            <a class="proc__link" href={docHref(p.slug)} data-goto={p.slug}>
              <span class="proc__name">{p.data.name}</span>
              <span class="proc__go" aria-hidden="true">→</span>
            </a>
            {p.data.description && <p class="proc__desc">{p.data.description}</p>}
            <ol class="proc__stages">
              {p.data.stages.map((st) => <li class="proc__stage">{st.name}</li>)}
            </ol>
            <dl class="proc__nums">
              <div><dd>{p.activities}</dd><dt>Activities</dt></div>
              <div><dd>{p.data.stages.length}</dd><dt>Stages</dt></div>
              <div><dd class:list={{ 'proc__open': p.open > 0 }}>{p.open}</dd><dt>Open slots</dt></div>
            </dl>
            {p.data.constraint && (
              <p class="proc__constraint">
                <span class="proc__constraint-mark"><span class="proc__constraint-glyph">①</span> {team.artifacts.find((a) => a.id === p.data.constraint!.artifact)?.name ?? p.data.constraint.artifact} —</span>
                {p.data.constraint.note}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>

    <div class="cats">
      <section class="module cat" aria-label="Roles">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Roles</span>
        </div>
        <ul class="rows rows--stack">
          {team.roles.map((r) => (
            <li class="row">
              <span class="row__id">{r.id}</span>
              <span class="row__name">{r.name}</span>
              {r.note && <span class="row__note">{r.note}</span>}
            </li>
          ))}
        </ul>
      </section>

      <section class="module cat" aria-label="Harnesses">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Harnesses</span>
          <span class="module__meta">runtimes capability can live in</span>
        </div>
        <ul class="rows">
          {team.harnesses.map((h) => (
            <li class="row">
              <span class="row__name">{h.name}</span>
              <span class="row__id">{h.id}</span>
              {h.note && <span class="row__note">{h.note}</span>}
              <span class="row__use">
                {[...(harnessUse.get(h.id) ?? [])].join(' · ') || 'shelf inventory'}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="module cat" aria-label="Tooling">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Tooling</span>
          <span class="module__meta">grouped by harness</span>
        </div>
        <div>
          {team.harnesses.map((h) => {
            const owned = team.tools.filter((s) => s.harness === h.id);
            return owned.length === 0 ? null : (
              <section class="tools__group">
                <div class="tools__head">
                  <span class="tools__harness">{h.name}</span>
                  <span class="tools__count">{owned.length}</span>
                </div>
                <ul class="tools__list">
                  {owned.map((s) => (
                    <li class="tool">
                      <span class="tool__name">{s.name}</span>
                      <span class="chip chip--muted">{s.kind}</span>
                      <span class="tool__when">
                        {(toolUse.get(s.id) ?? []).length === 0 ? 'shelf inventory' : (toolUse.get(s.id) ?? []).map((u, i) => (
                          <>
                            {i > 0 && <span aria-hidden="true"> · </span>}
                            <a class="row__go" href={useHref(u)} data-goto={u.slug} data-focus={u.focus}>{u.label}</a>
                          </>
                        ))}
                      </span>
                      {s.note && <span class="tool__note">{s.note}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
        </div>
      </section>

      <section class="module cat" aria-label="Events">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Events</span>
          <span class="module__meta">conditions that trigger tooling</span>
        </div>
        <ul class="rows rows--event">
          {team.events.map((e) => (
            <li class="row">
              <span class="row__name">{e.name}</span>
              <span class="row__id">{e.id}</span>
              {e.description && <span class="row__note">{e.description}</span>}
              <span class="row__use">
                <svg class="row__bolt" viewBox="0 0 8 10" aria-hidden="true"><path d="M4.6 0 1 5.6h2.3L2.7 10 7 4.2H4.4Z" fill="currentColor" /></svg>
                {(eventUse.get(e.id) ?? []).length === 0 ? 'no play yet' : (eventUse.get(e.id) ?? []).map((u, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true"> · </span>}
                    <a class="row__go" href={useHref(u)} data-goto={u.slug} data-focus={u.focus}>{u.label}</a>
                  </>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="module cat" aria-label="Artifacts">
        <div class="module__head">
          <span class="tab">CATALOG</span>
          <span class="module__title">Artifacts</span>
          <span class="module__meta">the joints of every handoff</span>
        </div>
        <ul class="rows rows--tight">
          {team.artifacts.map((a) => (
            <li class="row">
              <span class="row__name">{a.name}</span>
              <span class="row__id">{a.id}</span>
              <span class="row__use">
                {(artifactUse.get(a.id) ?? []).length === 0 ? 'unused' : (artifactUse.get(a.id) ?? []).map((u, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true"> · </span>}
                    <a class="row__go" href={useHref(u)} data-goto={u.slug} data-focus={u.focus}>{u.label}</a>
                  </>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>

    </div>
  </main>
  <TeamDrawer team={team} teamId={teamId} />
</section>

<style>
  /* Every cell draws its own top and left rule, so a card that wraps to a second
     row is separated from the row above it. The container is pulled 1px up and
     left so the first row and column land on the module's own borders instead of
     doubling them — this holds at any card count and any column count. */
  .procs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    margin: -1px 0 0 -1px;
  }
  .proc {
    padding: 14px 16px 16px;
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .proc__link {
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
  }
  /* A card title, not the page title: at the headline step it competed with the
     masthead, so it takes the title step and the underline thins with it. */
  .proc__name {
    font-size: var(--title);
    line-height: 24px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
    transition: border-color 0.14s var(--ease-out), color 0.14s var(--ease-out);
  }
  .proc__go {
    font-size: var(--subhead);
    color: var(--muted);
    transition: color 0.14s var(--ease-out);
  }
  .proc__link:hover .proc__name,
  .proc__link:focus-visible .proc__name {
    color: var(--accent);
    border-color: var(--accent);
  }
  .proc__link:hover .proc__go,
  .proc__link:focus-visible .proc__go {
    color: var(--accent);
  }
  .proc__desc {
    font-size: var(--body);
    line-height: 17px;
    color: var(--sub);
    max-width: 56ch;
  }
  .proc__stages {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }
  .proc__stage {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .proc__stage + .proc__stage::before {
    content: '→';
    margin-right: 5px;
    color: var(--muted);
    font-weight: 400;
  }
  .proc__nums {
    display: flex;
    border-top: 1px solid var(--line);
    margin-top: 2px;
  }
  .proc__nums > div {
    padding: 7px 14px 6px 0;
  }
  .proc__nums dd {
    font-size: var(--subhead);
    font-weight: 800;
    line-height: 20px;
  }
  .proc__open {
    color: var(--accent);
  }
  .proc__nums dt {
    font-size: var(--micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sub);
  }
  /* The constraint is a footnote to the card, not a second body paragraph: a
     measure holds it in instead of a filled band running the whole width, which
     at this width read as more important than the numbers above it. */
  .proc__constraint {
    display: block;
    max-width: 64ch;
    margin-top: 2px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
    font-size: var(--label);
    line-height: 15px;
    color: var(--sub);
  }
  .proc__constraint-mark {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .proc__constraint-glyph {
    color: var(--accent);
  }

  /* Every catalog is a full-width band, and the columns live inside it. Laying
     the catalogs out as columns of the page instead made width a function of how
     many catalogs there happen to be: five short indexes squeezed the long ones
     and left voids under the short ones. Banding them puts each index's own
     length in charge of how many columns it takes, so no catalog is squashed by
     a neighbour and the page uses whatever width it is given. */
  .cats {
    display: grid;
    gap: 8px;
  }
  /* Tooling is grouped by harness, so the harness leaves the row and becomes a
     band; the entry then fits one catalog column like every other catalog. */
  .tools__group {
    border-bottom: 1px solid var(--line);
  }
  .tools__group:last-child {
    border-bottom: none;
  }
  .tools__head {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 8px 4px;
    background: var(--washi);
  }
  .tools__harness {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tools__count {
    margin-left: auto;
    font-size: var(--micro);
    color: var(--sub);
  }
  /* The band is wide, the entries are one line each: flow them in columns ruled
     by the same hairline that divides everything else, so the shelf reads as an
     inventory rather than one very long list down the left edge. Capped at
     three: uncapped, a wide display keeps splitting until the name and its
     usage tag can no longer share a line. */
  .tools__list {
    columns: 320px 3;
    column-gap: 17px;
    column-rule: 1px solid var(--line);
  }
  .tool {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    padding: 5px 8px 4px;
    break-inside: avoid;
  }
  /* The other four catalogs band their rows; tooling reads as the same kind of
     list, so it bands too. Zebra rather than a bottom rule: a rule under the
     last entry of a column would end in mid-air where the column stops. */
  .tool:nth-child(even) {
    background: var(--washi);
  }
  .tool__name {
    font-size: var(--body);
    font-weight: 700;
  }
  .tool__note {
    flex-basis: 100%;
    font-size: var(--label);
    line-height: 15px;
    color: var(--sub);
  }
  .tool__when {
    margin-left: auto;
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
  }
  /* Grid, not a multicol flow: in multicol every entry keeps its own height, so a
     note that wraps gave each column its own baselines and no two hairlines ever
     met across the catalog. A grid row is shared — every cell takes the tallest
     one's height — so the rules line up the whole way across. Each cell draws its
     own top and left rule and the list is pulled 1px up and left, landing the
     first row and column on the module's own border instead of doubling it: the
     same construction the process cards use. Wider than tooling's column because
     these entries carry a note on its own line. Zebra belonged to the flow — under
     a grid, nth-child banding checkerboards instead of striping, and the rules now
     do that work. */
  .rows {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    margin: -1px 0 0 -1px;
  }
  /* Artifacts are a name, an id and a usage tag — one line, so they pack tighter. */
  .rows--tight {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  /* Roles are the one catalog every figure is drawn against, so they stack instead
     of running inline: the id leads as a muted kicker — it is the key the YAML and
     the lens chips use — the name takes the subhead step under it, and the note
     follows. Read down a column, the three sizes give the entry a shape the
     single-line catalogs do not need. */
  .rows--stack {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .rows--stack .row {
    display: block;
    padding: 9px 10px 10px;
  }
  /* The kicker recedes by case and tracking, not by a lighter gray: at 9px on
     white the muted step is 2.85:1, and this id is the key the YAML and the lens
     chips both speak. It keeps the base row id's sub color. */
  .rows--stack .row__id {
    display: block;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 3px;
  }
  .rows--stack .row__name {
    display: block;
    font-size: var(--subhead);
    line-height: 20px;
    font-weight: 800;
    margin-bottom: 4px;
  }
  .rows--stack .row__note {
    display: block;
    max-width: 40ch;
  }
  /* An event row is an if and a then. The other catalogs' usage tag says where an
     entry is used; here it names the tooling the condition fires, which is the
     playbook's event voice — so it speaks in it: green, bold, behind the bolt. */
  .rows--event .row__use {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent);
    font-weight: 700;
  }
  .rows--event .row__bolt {
    flex: none;
    width: 8px;
    height: 10px;
  }
  .rows--event .row__go {
    color: var(--accent);
    border-bottom-color: rgba(15, 107, 60, 0.35);
  }
  .row {
    display: flex;
    align-items: baseline;
    align-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    padding: 7px 8px 6px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .rows--tight .row {
    padding: 5px 8px 4px;
  }
  .row__name {
    font-size: var(--body);
    font-weight: 700;
  }
  .row__id {
    font-size: var(--micro);
    letter-spacing: 0.06em;
    color: var(--sub);
  }
  .row__note {
    font-size: var(--label);
    line-height: 15px;
    color: var(--sub);
    flex-basis: 100%;
  }
  .row__use {
    margin-left: auto;
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
    white-space: nowrap;
  }
  /* A live relationship is a door; a dead one ("unused", "shelf inventory") stays
     bare text in the same slot, so the two stop looking alike. */
  .row__go {
    color: var(--sub);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color 0.14s var(--ease-out), border-color 0.14s var(--ease-out);
  }
  .row__go:hover,
  .row__go:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 860px) {
    .row__use {
      margin-left: 0;
      flex-basis: 100%;
      white-space: normal;
    }
  }
</style>
