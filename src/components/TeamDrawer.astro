---
import type { OverviewModel } from '../lib/docs';
import { catalogDescriptions, md } from '../lib/markdown';
import { LEVEL_LABELS, toolsOfHarness } from '../lib/derive';
import { useHref } from '../lib/docs';
import ReachList from './ReachList.astro';
import UseList from './UseList.astro';
import RefSection from './RefSection.astro';

interface Props {
  model: OverviewModel;
  /** Set by the export, where every document shares one file and there are no routes. */
  inline?: boolean;
}
const { model, inline = false } = Astro.props;
const { team, teamId, roleUse, harnessUse, eventUse, toolReach, artifactReach, roleReach, openReach, openByProc, procs } = model;
const harnessNames = new Map(team.harnesses.map((h) => [h.id, h.name]));
const harnessName = (id: string) => harnessNames.get(id) ?? id;
const eventNames = new Map(team.events.map((e) => [e.id, e.name]));

// The catalogs are team-level, so this is where their descriptions belong: the
// process drawer explains an entity in the context of one flow, this one explains
// what it is at all and lists every process that touches it.
const descriptions = await catalogDescriptions(team);
// The team's own long form is not a catalog entry, so it renders on its own.
const teamProse = team.description ? await md(team.description) : null;

// The only panels not keyed to a catalog entry: an open slot has no id of its own,
// so the set is read together — once for the team, once per process that has any.
// One list rather than two blocks, so the two readings cannot drift into saying
// different things about the same rows.
const openPanels = [
  { key: '__open', name: 'Open Slots', rows: openReach, all: true },
  ...procs
    .filter((p) => p.open > 0)
    .map((p) => ({ key: `open:${p.slug}`, name: p.data.name, rows: openByProc.get(p.slug) ?? [], all: false })),
];
---

<aside class="tdrawer" id="team-drawer" hidden aria-label="Team document detail">
  <div class="module__head tdrawer__head">
    <span class="tab">DETAIL</span>
    <span class="module__title" data-drawer-title>Team Document</span>
    <button class="drawer-ctl drawer-ctl--back" data-drawer-back hidden aria-label="Back to the previous entry">← BACK</button>
    <button class="drawer-ctl drawer-ctl--close" data-team-drawer-close aria-label="Close detail drawer">CLOSE ✕</button>
  </div>

  <div class="tdrawer__body">
    <div class="tdrawer__panel" data-detail="__team" data-title="Team Document">
      <h3 class="tdrawer__name">{team.name}</h3>
      <div class="tdrawer__chips">
        <span class="chip chip--inverse">VERSION {team.version}</span>
        <span class:list={['chip', { 'tdrawer__chip-living': team.status === 'living' }]}>
          {team.status.toUpperCase()}
        </span>
      </div>

      {(team.note || teamProse) && (
        <div class="panel-section">
          <h4 class="panel-label">About</h4>
          {team.note && <p class="tdrawer__prose">{team.note}</p>}
          {teamProse && <div class="tdrawer__md prose-md" set:html={teamProse} />}
        </div>
      )}

      <RefSection refs={team.refs} label="Read from" />

      <div class="panel-section">
        <h4 class="panel-label">Source</h4>
        <p class="tdrawer__path">{teamId}/</p>
        <p class="tdrawer__none">
          One folder is one team: the document plus one file per process. The page has no
          write path — the editor is the editor.
        </p>
      </div>
    </div>

    {team.roles.map((r) => (
      <div class="tdrawer__panel" data-detail={`role:${r.id}`} data-title="Role" hidden>
        <h3 class="tdrawer__name">{r.name}</h3>
        <div class="tdrawer__chips">
          <span class="chip chip--inverse">ROLE</span>
          <span class="chip">{r.id}</span>
        </div>
        {r.note && <p class="tdrawer__prose">{r.note}</p>}
        {descriptions.has(`role:${r.id}`) && (
          <div class="tdrawer__md prose-md" set:html={descriptions.get(`role:${r.id}`)} />
        )}
        <div class="panel-section">
          <h4 class="panel-label">Works in</h4>
          <p class="tdrawer__uses">
            <UseList uses={roleUse.get(r.id) ?? []} empty="No activity names this role yet." emptyClass="tdrawer__none" />
          </p>
        </div>
        <div class="panel-section">
          <h4 class="panel-label">Owns</h4>
          {(roleReach.get(r.id) ?? []).length ? (
            <ul class="tdrawer__list tdrawer__list--owns">
              {(roleReach.get(r.id) ?? []).map((w) => (
                <li>
                  <a
                    class="row__go tdrawer__act"
                    href={useHref({ slug: w.slug, label: w.activity, focus: `act-${w.actId}` }, inline)}
                    data-goto={w.slug}
                    data-focus={`act-${w.actId}`}
                  >
                    {w.activity}
                  </a>
                  <span class="tdrawer__via">
                    {[w.process, w.stage].filter(Boolean).join(' · ')}
                    {w.level ? ` · ${LEVEL_LABELS[w.level]}` : w.open ? ' · open slot' : ''}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="tdrawer__none">No activity names this role yet.</p>
          )}
        </div>
        <RefSection refs={r.refs} />
      </div>
    ))}

    {team.harnesses.map((h) => {
      const owned = toolsOfHarness(team, h.id);
      return (
        <div class="tdrawer__panel" data-detail={`harness:${h.id}`} data-title="Harness" hidden>
          <h3 class="tdrawer__name">{h.name}</h3>
          <div class="tdrawer__chips">
            <span class="chip chip--inverse">HARNESS</span>
            <span class="chip">{owned.length} TOOLS</span>
          </div>
          {h.note && <p class="tdrawer__prose">{h.note}</p>}
          {descriptions.has(`harness:${h.id}`) && (
            <div class="tdrawer__md prose-md" set:html={descriptions.get(`harness:${h.id}`)} />
          )}
          <div class="panel-section">
            <h4 class="panel-label">Tools</h4>
            {owned.length ? (
              <ul class="tdrawer__list">
                {owned.map((s) => (
                  <li>
                    <button type="button" class="tdrawer__tool-link" data-detail-key={`tool:${s.id}`}>{s.name}</button>
                    <span class="tdrawer__none">{s.kind}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="tdrawer__none">Nothing on the shelf runs in it yet.</p>
            )}
          </div>
          <div class="panel-section">
            <h4 class="panel-label">Reached for in</h4>
            <p class="tdrawer__uses">
              <UseList uses={harnessUse.get(h.id) ?? []} empty="Shelf inventory — no process reaches for it." emptyClass="tdrawer__none" />
            </p>
          </div>
          <RefSection refs={h.refs} />
        </div>
      );
    })}

    {team.tools.map((s) => (
      <div class="tdrawer__panel" data-detail={`tool:${s.id}`} data-title="Tool" hidden>
        <h3 class="tdrawer__name">{s.name}</h3>
        <div class="tdrawer__chips">
          <button type="button" class="chip chip--inverse chip--link" data-detail-key={`harness:${s.harness}`}>
            {harnessName(s.harness)}
          </button>
          <span class="chip">{s.kind}</span>
        </div>
        {s.note && <p class="tdrawer__prose">{s.note}</p>}
        {descriptions.has(`tool:${s.id}`) && (
          <div class="tdrawer__md prose-md" set:html={descriptions.get(`tool:${s.id}`)} />
        )}
        <div class="panel-section">
          <h4 class="panel-label">Reached for</h4>
          <ReachList
            rows={toolReach.get(s.id) ?? []}
            empty="Shelf inventory — nothing references it yet."
            eventNames={eventNames}
            inline={inline}
          />
        </div>
        <RefSection refs={s.refs} label="Refs" />
      </div>
    ))}

    {team.artifacts.map((a) => (
      <div class="tdrawer__panel" data-detail={`artifact:${a.id}`} data-title="Artifact" hidden>
        <h3 class="tdrawer__name">{a.name}</h3>
        <div class="tdrawer__chips">
          <span class="chip chip--inverse">ARTIFACT</span>
          <span class="chip">{a.id}</span>
        </div>
        {descriptions.has(`artifact:${a.id}`) && (
          <div class="tdrawer__md prose-md" set:html={descriptions.get(`artifact:${a.id}`)} />
        )}
        <div class="panel-section">
          <h4 class="panel-label">Changes hands</h4>
          <ReachList
            rows={artifactReach.get(a.id) ?? []}
            empty="Declared, but no activity produces or consumes it."
            inline={inline}
          />
        </div>
        <RefSection refs={a.refs} />
      </div>
    ))}

    {team.events.map((e) => (
      <div class="tdrawer__panel" data-detail={`event:${e.id}`} data-title="Event" hidden>
        <h3 class="tdrawer__name">{e.name}</h3>
        <div class="tdrawer__chips">
          <span class="chip chip--inverse">EVENT</span>
          <span class="chip">{e.id}</span>
        </div>
        {descriptions.has(`event:${e.id}`) && (
          <div class="tdrawer__md prose-md" set:html={descriptions.get(`event:${e.id}`)} />
        )}
        <div class="panel-section">
          <h4 class="panel-label">Answered by</h4>
          <p class="tdrawer__uses">
            <UseList uses={eventUse.get(e.id) ?? []} empty="Defined, but nothing is bound to it yet." emptyClass="tdrawer__none" />
          </p>
        </div>
        <RefSection refs={e.refs} />
      </div>
    ))}

    {openPanels.map((o) => (
      <div class="tdrawer__panel" data-detail={o.key} data-title="Open Slots" hidden>
        <h3 class="tdrawer__name">{o.name}</h3>
        <div class="tdrawer__chips">
          <span class="chip chip--accent">{o.rows.length} {o.all ? 'DECLARED' : 'OPEN'}</span>
          {!o.all && <button type="button" class="chip chip--link" data-detail-key="__open">ALL PROCESSES</button>}
        </div>
        {o.all && (
          <p class="tdrawer__prose">
            Work this team has decided to hand to a tool and has not yet. Each one names what
            it needs, in the team's own words.
          </p>
        )}
        <div class="panel-section">
          <h4 class="panel-label">Waiting on</h4>
          <ReachList
            rows={o.rows}
            empty="Nothing is declared open. Every activity is either filled or done by hand on purpose."
            inline={inline}
          />
        </div>
      </div>
    ))}
  </div>
</aside>

<script>
  import { panelNav } from '../lib/panel-nav';

  const drawer = document.getElementById('team-drawer');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-open-team]');
  if (drawer && openers.length) {
    let opener: HTMLButtonElement | null = null;
    const back = drawer.querySelector<HTMLButtonElement>('[data-drawer-back]');
    const closeBtn = drawer.querySelector<HTMLButtonElement>('[data-team-drawer-close]');
    // The drawer is one surface with many readings: the chrome control opens the
    // team itself, a catalog name opens that entry. Only the key differs.
    const nav = panelNav(drawer, {
      title: drawer.querySelector<HTMLElement>('[data-drawer-title]'),
      back,
      close: closeBtn,
    });

    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      for (const b of openers) b.setAttribute('aria-expanded', String(open));
    };
    const close = () => {
      setOpen(false);
      // The drawer is opened from a single line of chrome; without this the focus
      // ring lands at the top of the document and the reader loses their place.
      opener?.focus();
      opener = null;
    };

    for (const btn of openers) {
      btn.addEventListener('click', () => {
        opener = btn;
        nav.show('__team');
        setOpen(true);
        closeBtn?.focus();
      });
    }

    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-detail-key]');
      const key = el?.dataset.detailKey;
      if (!key || !nav.has(key)) return;
      // A name clicked inside an open drawer is a step deeper, so it records the
      // panel being left; one clicked on the page starts the reading over.
      const deeper = Boolean(el!.closest('#team-drawer')) && !drawer.hidden;
      if (!deeper) opener = el instanceof HTMLButtonElement ? el : null;
      nav.show(key, deeper, { invoker: el });
      setOpen(true);
      // Stepping deeper puts the way out under the cursor's own hand: the back
      // control, not close, is what a reader one panel down wants next.
      (nav.depth() ? back : closeBtn)?.focus();
    });
    closeBtn?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) close();
    });
    // There is no scrim to click, so the page itself dismisses: anything outside
    // the panel that is not the control that opened it closes the reading.
    document.addEventListener('click', (e) => {
      if (drawer.hidden) return;
      const t = e.target as HTMLElement | null;
      if (t?.closest('#team-drawer') || t?.closest('[data-open-team]') || t?.closest('[data-detail-key]')) return;
      setOpen(false);
      opener = null;
    });
  }
</script>

<style>
  .tdrawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--drawer-w);
    background: var(--white);
    border-left: 1px solid var(--ink);
    z-index: 40;
    display: flex;
    flex-direction: column;
  }
  .tdrawer[hidden] {
    display: none;
  }
  .tdrawer__head {
    background: var(--white);
  }
  .tdrawer__body {
    overflow-y: auto;
    padding: 12px;
  }
  .tdrawer__name {
    font-size: var(--subhead);
    line-height: 20px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .tdrawer__chips {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 7px;
  }
  .tdrawer__chip-living {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tdrawer__prose {
    font-size: var(--prose);
    line-height: 20px;
    font-weight: 400;
  }
  .tdrawer__prose + .tdrawer__prose {
    margin-top: 8px;
  }
  /* The chips are a caption on the name above them; the note is the next
     paragraph, not a third line of the same block. */
  .tdrawer__chips + .tdrawer__prose,
  .tdrawer__chips + .tdrawer__md {
    margin-top: 10px;
  }
  .tdrawer__path {
    font-size: var(--prose);
    line-height: 20px;
    font-weight: 700;
  }
  /* The drawer is a reading surface, not an index: its notes take the body step
     and the panel's own width. A 44ch measure inside a 400px panel wrapped the
     note two words early for no gain — the panel is already the measure. */
  .tdrawer__none {
    font-size: var(--prose);
    line-height: 20px;
    color: var(--sub);
    margin-top: 6px;
  }
  .tdrawer__panel[hidden] {
    display: none;
  }
  .tdrawer__uses {
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .tdrawer__uses .tdrawer__none {
    margin-top: 0;
    font-size: var(--micro);
    text-transform: none;
    letter-spacing: 0;
  }
  .tdrawer__list {
    list-style: none;
    font-size: var(--body);
    line-height: 18px;
  }
  /* The shelf entry is a door too. The size and weight are restated rather than
     inherited through the `font` shorthand, which would also take the button's
     UA metrics along with the family. */
  .tdrawer__tool-link {
    font-family: inherit;
    font-size: var(--body);
    line-height: 18px;
    font-weight: 700;
    color: inherit;
    cursor: pointer;
    border-bottom: 1px solid var(--line);
    transition: color 0.14s var(--ease-out), border-color 0.14s var(--ease-out);
  }
  .tdrawer__tool-link:hover,
  .tdrawer__tool-link:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* Same shape the process drawer's Owns list draws — the activity in ink, its
     place and degree of delegation trailing it as a caption on the same line. */
  .tdrawer__act {
    font-weight: 700;
    color: var(--ink);
  }
  /* A word space is not enough behind an underlined door: the rule runs to the
     glyph edge, so the caption started before the name had finished. */
  .tdrawer__via {
    margin-left: 7px;
    font-size: var(--label);
    color: var(--sub);
  }
  /* Every row carries an underlined door, so the 4px the shelf lists use puts the
     rule of one line against the descenders of the next. */
  .tdrawer__list--owns {
    line-height: 20px;
  }
  .tdrawer__list--owns li + li {
    margin-top: 7px;
  }
  .tdrawer__list li + li {
    margin-top: 4px;
  }
  .tdrawer__list .tdrawer__none {
    margin-top: 0;
    font-size: var(--micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* Authored markdown, so the panel styles the tags it can actually receive
     rather than a class per element. The body step, not the prose one: this is the
     longest block in a panel, and at 14px it outweighed both the entry name above
     it and every row derived below it — one description read as a document pasted in. */
  .tdrawer__md {
    margin-top: 8px;
    font-size: var(--body);
    line-height: 17px;
  }
</style>
