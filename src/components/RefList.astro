---
/* The one place a `refs:` list is drawn. Every shelf in the document takes the
   same field, so the reading of it is decided once here rather than at each of
   the thirteen places a panel files one.
   The split is done at build time because it is a fact about the string, not a
   decision: a URL already names its host and its path, and printing them apart
   is only agreeing to read what is written. Styles live in `global.css` — the
   markup is drawn here and consumed by two drawers, and an Astro `<style>`
   reaches only the component that renders the tags. */
import { isLinkableRef } from '../lib/derive';
import type { Ref } from '../lib/schema';

interface Props {
  refs?: Ref[];
}

const { refs = [] } = Astro.props;

/** host + path, or null when the string is not a URL this can read. */
const split = (ref: string): { host: string; path: string } | null => {
  try {
    const u = new URL(ref.startsWith('//') ? `https:${ref}` : ref);
    // A mailto has no host — the address is the whole of it, and it is the part
    // worth reading.
    if (u.protocol === 'mailto:') return { host: u.pathname, path: '' };
    const rest = `${u.pathname}${u.search}${u.hash}`;
    return {
      host: u.host,
      // A lone slash is not a path, it is the absence of one; and an escaped
      // space is a space, which is what the page it names actually says.
      path: rest === '/' ? '' : decodeURI(rest),
    };
  } catch {
    return null;
  }
};
---

{refs.length > 0 && (
  <ul class="refs">
    {refs.map((ref) => {
      const { name, value } =
        typeof ref === 'string' ? { name: undefined, value: ref } : { name: ref.name, value: ref.url };
      const parts = isLinkableRef(value) ? split(value) : null;
      return (
        <li>
          {parts ? (
            /* A name the author gave is the whole of what the row says: the
               address is what the reader was going to click anyway, and the
               `title` keeps it one hover away for anyone who wants to check
               where the door leads before opening it. */
            <a class="refs__link" href={value} target="_blank" rel="noreferrer" title={name ? value : undefined}>
              {name
                ? <span class="refs__name">{name}</span>
                : <span class="refs__host">{parts.host}</span>}<svg class="refs__out" viewBox="0 0 8 8" aria-hidden="true"><path d="M1.4 6.6 6.4 1.6M3.6 1.6h2.8v2.8" fill="none" stroke="currentColor" stroke-width="1" /></svg>
              {!name && parts.path && <span class="refs__path">{parts.path}</span>}
            </a>
          ) : (
            /* Nothing to press, so nothing carries the address for the reader:
               a named shelf or repo path prints both, the name leading. */
            <>
              {name && <span class="refs__name">{name}</span>}
              <span class="refs__plain">{value}</span>
            </>
          )}
        </li>
      );
    })}
  </ul>
)}
