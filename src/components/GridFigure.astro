---
import type { Team } from '../lib/derive';
import GridCard from './GridCard.astro';
import GridNest from './GridNest.astro';

interface Props {
  team: Team;
}
const { team } = Astro.props;

const cell = (roleId: string, stageId: string) =>
  team.activities.filter((a) => a.stage === stageId && a.roles.includes(roleId));
---

<section class="module grid" aria-label="Stage by Role Grid">
  <div class="module__head">
    <span class="tab">GRID</span>
    <span class="module__title">Capability Slots by Stage × Role</span>
    <span class="grid__scrollhint" aria-hidden="true">scroll →</span>
    <span class="module__meta">dashed = a slot the team has declared open · indented = a slot inside the one above · no line = work they do themselves</span>
  </div>
  <div class="grid__scroll">
    <table class="grid__table">
      <thead>
        <tr>
          <th class="grid__corner" scope="col"><span class="grid__corner-label">Role ↓ / Stage →</span></th>
          {team.stages.map((s) => (
            <th scope="col" class="grid__stage"><span class="tab">{s.name}</span></th>
          ))}
        </tr>
      </thead>
      <tbody>
        {team.roles.map((r) => (
          <tr data-roles={r.id}>
            <th scope="row" class="grid__role">
              <span class="grid__role-name">{r.name}</span>
              <span class="grid__role-note">{r.note}</span>
            </th>
            {team.stages.map((s) => {
              const acts = cell(r.id, s.id);
              return (
                <td class="grid__cell">
                  {/* No "N inside" marker: the grid draws the children, so the
                      count restates what the cell already shows. */}
                  {acts.map((a) => (
                    <div class="grid__slot">
                      <GridCard team={team} act={a} depth="0" />
                      {(a.activities?.length ?? 0) > 0 && (
                        <GridNest team={team} activities={a.activities!} rowRole={r.id} />
                      )}
                    </div>
                  ))}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  /* Sideways travel only — see the same rule in FlowFigure: an implied
     `overflow-y: auto` nests a second vertical scrollbar inside the page's. */
  .grid__scroll {
    overflow-x: auto;
    overflow-y: hidden;
  }
  .grid__table {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
  }
  .grid__table th,
  .grid__table td {
    border: 1px solid var(--line);
    vertical-align: top;
    text-align: left;
  }
  .grid__table tr > *:first-child {
    border-left: none;
  }
  .grid__table tr > *:last-child {
    border-right: none;
  }
  .grid__table thead th {
    border-top: none;
  }
  .grid__table tbody tr:last-child > * {
    border-bottom: none;
  }
  .grid__corner {
    width: 150px;
    padding: 6px 10px;
    background: var(--washi);
  }
  .grid__corner-label {
    font-size: var(--micro);
    letter-spacing: 0.08em;
    color: var(--sub);
    text-transform: uppercase;
    font-weight: 600;
  }
  .grid__stage {
    padding: 6px 8px;
    background: var(--washi);
  }
  .grid__role {
    width: 150px;
    padding: 8px 10px;
  }
  .grid__role-name {
    display: block;
    font-size: var(--body);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .grid__role-note {
    display: block;
    margin-top: 3px;
    font-size: var(--micro);
    line-height: 12px;
    color: var(--sub);
    font-weight: 400;
  }
  .grid__cell {
    padding: 6px;
    min-width: 148px;
  }
  .grid__slot + .grid__slot {
    margin-top: 8px;
  }
  .grid__scrollhint {
    display: none;
    font-size: var(--micro);
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .grid__scrollhint {
      display: inline;
    }
  }
  tr[data-roles] {
    transition: opacity 0.28s var(--ease-out);
  }
</style>
