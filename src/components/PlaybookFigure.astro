---
import type { Team } from '../lib/derive';
import { LEVEL_LABELS, toolOf } from '../lib/derive';

interface Props {
  team: Team;
}
const { team } = Astro.props;

const eventName = (id: string) => team.events.find((e) => e.id === id)?.name ?? id;
const stageName = (id: string) => team.stages.find((s) => s.id === id)?.name ?? id;

// A role's playbook is read off the activities it owns — the catalog no longer
// states roles, so recommendations inherit them from the work they annotate. One
// button per tool, with a line per activity that reaches for it.
const rows = team.roles.map((role) => {
  const owned = team.activities.filter((a) => a.roles.includes(role.id));
  const fills = owned.filter((a) => a.tooling);
  const byTool = new Map<string, { id: string; lines: { event?: string; activity: string }[] }>();
  for (const a of owned) {
    for (const r of a.recommends ?? []) {
      const entry = byTool.get(r.tool) ?? { id: r.tool, lines: [] };
      entry.lines.push({ event: r.event, activity: a.name });
      byTool.set(r.tool, entry);
    }
  }
  const tools = [...byTool.values()].map((e) => ({ ...toolOf(team, e.id), lines: e.lines }));
  const harnesses = team.harnesses.filter(
    (h) =>
      tools.some((s) => s.harness === h.id) ||
      fills.some((a) => toolOf(team, a.tooling!.tool).harness === h.id)
  );
  return { role, tools, fills, harnesses };
});
---

<section class="module pb" aria-label="Playbook">
  <div class="module__head">
    <span class="tab">PLAYBOOK</span>
    <span class="module__title">Harness + Tooling by Role</span>
    <span class="module__meta">select a role above · tooling fires on events, not just process position</span>
  </div>

  {rows.map(({ role, tools, fills, harnesses }) => (
    <div class="pb__role" data-roles={role.id}>
      <div class="pb__ghost" aria-hidden="true">
        <span class="pb__ghost-name">{role.name}</span>
        <span class="pb__ghost-note">outside the current lens</span>
      </div>
      <div class="pb__rolehead">
        <span class="pb__rolename">{role.name}</span>
        <span class="pb__rolenote">{role.note}</span>
        <span class="pb__count">{tools.length} TOOLS · {fills.length} TOOLED ACTIVITIES</span>
      </div>
      {harnesses.length === 0 && (
        <p class="pb__empty">No harness tooling recommended yet — this role's playbook is an open slot.</p>
      )}
      <div class="pb__harnesses">
        {harnesses.map((h) => (
          <div class="pb__harness">
            <div class="pb__harnesshead">
              <span class="pb__harnessname">{h.name}</span>
              {h.note && <span class="pb__harnessnote">{h.note}</span>}
            </div>
            {tools
              .filter((s) => s.harness === h.id)
              .map((s) => (
                <button class="pb__item" data-tool={s.id} data-roles={role.id} aria-label={`${s.name} — details`}>
                  <span class="pb__itemname">
                    {s.name}
                  </span>
                  <span class="pb__itemsub">{s.kind}</span>
                  {s.lines.map((w) => (
                    <span class={`pb__when${w.event ? ' pb__when--event' : ''}`}>
                      {w.event && (
                        <svg class="pb__bolt" viewBox="0 0 8 10" aria-hidden="true"><path d="M4.6 0 1 5.6h2.3L2.7 10 7 4.2H4.4Z" fill="currentColor" /></svg>
                      )}
                      {w.event ? `${eventName(w.event)} · ` : ''}
                      during {w.activity}
                    </span>
                  ))}
                </button>
              ))}
            {fills
              .filter((a) => toolOf(team, a.tooling!.tool).harness === h.id)
              .map((a) => (
                <button class="pb__item pb__item--fill" data-act={a.id} data-roles={a.roles.join(' ')} data-depth="pb" aria-label={`${a.name} — details`}>
                  <span class="pb__itemname">
                    {toolOf(team, a.tooling!.tool).name}
                    <span class="chip chip--muted">{LEVEL_LABELS[a.tooling!.level]}</span>
                  </span>
                  <span class="pb__when">fills {a.name} · {stageName(a.stage)}</span>
                </button>
              ))}
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .pb__role {
    border-bottom: 1px solid var(--line);
    padding: 10px 12px 12px;
    transition: opacity 0.28s var(--ease-out);
  }
  .pb__role:last-child {
    border-bottom: none;
  }
  .pb__ghost {
    display: none;
    align-items: baseline;
    gap: 10px;
    padding: 2px 0;
  }
  .pb__ghost-name {
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .pb__ghost-note {
    font-size: var(--micro);
    letter-spacing: 0.05em;
    color: var(--sub);
    text-transform: uppercase;
  }
  .pb__rolehead {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .pb__rolename {
    font-size: var(--subhead);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .pb__rolenote {
    font-size: var(--label);
    color: var(--sub);
  }
  .pb__count {
    margin-left: auto;
    font-size: var(--micro);
    letter-spacing: 0.08em;
    color: var(--sub);
    font-weight: 600;
  }
  .pb__empty {
    font-size: 11px;
    color: var(--sub);
    padding: 4px 0;
  }
  .pb__harnesses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 8px;
  }
  .pb__harness {
    border: 1px solid var(--line);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--white);
  }
  .pb__harnesshead {
    border-bottom: 1px solid var(--line);
    padding-bottom: 5px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pb__harnessname {
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pb__harnessnote {
    font-size: var(--micro);
    color: var(--sub);
  }
  .pb__item {
    border: 1px solid var(--ink);
    padding: 6px 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--white);
    transition: background 0.12s ease-out, color 0.12s ease-out, opacity 0.28s var(--ease-out);
  }
  .pb__item:hover {
    background: var(--washi);
  }
  /* Same selection mark as the figures: washi plus a green spine, never an invert.
     The event lines keep their own green because the text colour never changes. */
  .pb__item[aria-current='true'] {
    background: var(--washi);
    border-left: 2px solid var(--accent);
  }

  .pb__item--fill {
    border-style: solid;
    border-color: var(--line);
  }
  .pb__itemname {
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pb__itemsub {
    font-size: var(--micro);
    letter-spacing: 0.04em;
    color: var(--sub);
  }
  .pb__when {
    font-size: var(--micro);
    color: var(--sub);
    letter-spacing: 0.03em;
  }
  .pb__when--event {
    color: var(--accent);
    font-weight: 700;
  }
  .pb__bolt {
    width: 7px;
    height: 9px;
    margin-right: 3px;
    vertical-align: -1px;
  }
</style>
