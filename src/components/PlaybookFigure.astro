---
import type { Team } from '../lib/derive';
import { LEVEL_LABELS } from '../lib/derive';

interface Props {
  team: Team;
}
const { team } = Astro.props;

const eventName = (id: string) => team.events.find((e) => e.id === id)?.name ?? id;
const activityName = (id: string) => team.activities.find((a) => a.id === id)?.name ?? id;
const stageName = (id: string) => team.stages.find((s) => s.id === id)?.name ?? id;

const rows = team.roles.map((role) => {
  const skills = team.skills.filter((s) => s.roles.includes(role.id));
  const fills = team.activities.filter((a) => a.roles.includes(role.id) && a.tooling);
  const harnesses = team.harnesses.filter(
    (h) => skills.some((s) => s.harness === h.id) || fills.some((a) => a.tooling!.harness === h.id)
  );
  return { role, skills, fills, harnesses };
});
---

<section class="module pb" aria-label="Figure 03 — Playbook">
  <div class="module__head">
    <span class="tab">FIG.03</span>
    <span class="module__title">Playbook — Harness + Tooling by Role</span>
    <span class="module__meta">select a role above · skills fire on events, not just process position</span>
  </div>

  {rows.map(({ role, skills, fills, harnesses }) => (
    <div class="pb__role" data-roles={role.id}>
      <div class="pb__ghost" aria-hidden="true">
        <span class="pb__ghost-name">{role.name}</span>
        <span class="pb__ghost-note">outside the current lens</span>
      </div>
      <div class="pb__rolehead">
        <span class="pb__rolename">{role.name}</span>
        <span class="pb__rolenote">{role.note}</span>
        <span class="pb__count">{skills.length} SKILLS · {fills.length} TOOLED ACTIVITIES</span>
      </div>
      {harnesses.length === 0 && (
        <p class="pb__empty">No harness tooling recommended yet — this role's playbook is an open slot.</p>
      )}
      <div class="pb__harnesses">
        {harnesses.map((h) => (
          <div class="pb__harness">
            <div class="pb__harnesshead">
              <span class="pb__harnessname">{h.name}</span>
              {h.note && <span class="pb__harnessnote">{h.note}</span>}
            </div>
            {skills
              .filter((s) => s.harness === h.id)
              .map((s) => (
                <button class="pb__item" data-skill={s.id} data-roles={s.roles.join(' ')} aria-label={`${s.name} — details`}>
                  <span class="pb__itemname">
                    {s.name}
                    {s.level && <span class="chip chip--muted">{LEVEL_LABELS[s.level]}</span>}
                  </span>
                  <span class="pb__itemsub">{s.tooling}</span>
                  {s.when.map((w) => (
                    <span class={`pb__when${w.event ? ' pb__when--event' : ''}`}>
                      {w.event && (
                        <svg class="pb__bolt" viewBox="0 0 8 10" aria-hidden="true"><path d="M4.6 0 1 5.6h2.3L2.7 10 7 4.2H4.4Z" fill="currentColor" /></svg>
                      )}
                      {w.event ? eventName(w.event) : ''}
                      {w.event && w.activity ? ' · ' : ''}
                      {w.activity ? `during ${activityName(w.activity)}` : ''}
                    </span>
                  ))}
                </button>
              ))}
            {fills
              .filter((a) => a.tooling!.harness === h.id)
              .map((a) => (
                <button class="pb__item pb__item--fill" data-act={a.id} data-roles={a.roles.join(' ')} data-depth="pb" aria-label={`${a.name} — details`}>
                  <span class="pb__itemname">
                    {a.tooling!.tooling}
                    <span class="chip chip--muted">{LEVEL_LABELS[a.tooling!.level]}</span>
                  </span>
                  <span class="pb__when">fills {a.name} · {stageName(a.stage)}</span>
                </button>
              ))}
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .pb__role {
    border-bottom: 1px solid var(--line);
    padding: 10px 12px 12px;
    transition: opacity 0.28s var(--ease-out);
  }
  .pb__role:last-child {
    border-bottom: none;
  }
  .pb__ghost {
    display: none;
    align-items: baseline;
    gap: 10px;
    padding: 2px 0;
  }
  .pb__ghost-name {
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pb__ghost-note {
    font-size: var(--micro);
    letter-spacing: 0.05em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .pb__rolehead {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .pb__rolename {
    font-size: var(--subhead);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .pb__rolenote {
    font-size: var(--label);
    color: var(--sub);
  }
  .pb__count {
    margin-left: auto;
    font-size: var(--micro);
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 600;
  }
  .pb__empty {
    font-size: 11px;
    color: var(--sub);
    padding: 4px 0;
  }
  .pb__harnesses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 8px;
  }
  .pb__harness {
    border: 1px solid var(--line);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--white);
  }
  .pb__harnesshead {
    border-bottom: 1px solid var(--line);
    padding-bottom: 5px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pb__harnessname {
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pb__harnessnote {
    font-size: var(--micro);
    color: var(--muted);
  }
  .pb__item {
    border: 1px solid var(--ink);
    padding: 6px 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--white);
    transition: background 0.12s ease-out, color 0.12s ease-out, opacity 0.28s var(--ease-out);
  }
  .pb__item:hover {
    background: var(--washi);
  }
  .pb__item[aria-current='true'] {
    background: var(--ink);
    color: var(--white);
  }
  .pb__item--fill {
    border-style: solid;
    border-color: var(--line);
  }
  .pb__itemname {
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pb__itemsub {
    font-size: var(--micro);
    letter-spacing: 0.04em;
    color: var(--sub);
  }
  .pb__when {
    font-size: var(--micro);
    color: var(--sub);
    letter-spacing: 0.03em;
  }
  .pb__when--event {
    color: var(--accent);
    font-weight: 700;
  }
  .pb__bolt {
    width: 7px;
    height: 9px;
    margin-right: 3px;
    vertical-align: -1px;
  }
  .pb__item[aria-current='true'] .pb__itemsub,
  .pb__item[aria-current='true'] .pb__when {
    color: var(--line);
  }
  .pb__item[aria-current='true'] .pb__when--event {
    color: #7fd6a8;
  }
  .pb__item[aria-current='true'] .chip--muted {
    color: var(--line);
    border-color: var(--sub);
  }
</style>
