---
import type { Team } from '../lib/derive';
import { derive, LEVEL_LABELS, LEVEL_ORDER, nameOf, statesCapability } from '../lib/derive';
import SubFlow from './SubFlow.astro';

interface Props {
  team: Team;
  /** Suffixes the SVG pattern id — the export holds one figure per process in one file. */
  docId?: string;
}
const { team, docId = 'doc' } = Astro.props;
const d = derive(team);
const hatchId = `idle-hatch-${docId}`;

const GUTTER = 150;
const BAND = 26;
const COLW = 150;
const LANEH = 112;
const NODEW = 126;
// NODEH is the layout unit, not a cap: a card grows with its name, so the stack
// reserves the tallest a card gets (three name lines) rather than the shortest.
const NODEH = 70;
const NODEH_MAX = 90;
// An echo carries the name alone, so two lines of micro type and its padding is
// the height it is reserved — the same "tallest it gets" rule as the card.
const ECHOH = 38;
const STACK_GAP = 10;
const EXPAND_H = 22;
const LANE_PAD = 11;

const actById = new Map(d.placed.map((p) => [p.activity.id, p.activity]));
const expandExtra = (id: string) => ((actById.get(id)?.activities?.length ?? 0) > 0 ? EXPAND_H : 0);

// One cell per (column, lane), holding everything drawn there: first the cards
// whose lead role owns the lane, then the echoes of activities led from another
// lane. Cards before echoes so a lane states its own work above the work it only
// shares. Parallel activities stack rather than overlap, and a lane grows to its
// deepest cell — which is why the lane's height is measured here and not assumed.
interface Item {
  id: string;
  echo: boolean;
  h: number;
}
const cells = new Map<string, Item[]>();
const cellKey = (col: number, lane: number) => `${col}:${lane}`;
const add = (col: number, lane: number, item: Item) => {
  const k = cellKey(col, lane);
  cells.set(k, [...(cells.get(k) ?? []), item]);
};
for (const p of d.placed) {
  add(p.col, p.lane, { id: p.activity.id, echo: false, h: NODEH_MAX + expandExtra(p.activity.id) });
}
for (const p of d.placed) {
  for (const lane of p.echoes) add(p.col, lane, { id: p.activity.id, echo: true, h: ECHOH });
}

const stackH = (items: Item[]) =>
  items.reduce((a, i) => a + i.h, 0) + Math.max(0, items.length - 1) * STACK_GAP;

const laneHpx = team.roles.map((_, lane) => {
  let need = 0;
  for (let c = 0; c < d.cols; c++) need = Math.max(need, stackH(cells.get(cellKey(c, lane)) ?? []));
  return Math.max(LANEH, need + LANE_PAD * 2);
});
const laneY: number[] = [];
let acc = BAND;
for (const h of laneHpx) {
  laneY.push(acc);
  acc += h;
}

const width = GUTTER + d.cols * COLW;
const height = acc;

// An activity appears at most once in a cell — an echo lane is never its lead
// lane — so its own id locates it in the stack.
const place = (col: number, lane: number, id: string) => {
  const items = cells.get(cellKey(col, lane))!;
  const k = items.findIndex((i) => i.id === id);
  const above = items.slice(0, k).reduce((a, i) => a + i.h + STACK_GAP, 0);
  return {
    x: GUTTER + col * COLW + (COLW - NODEW) / 2,
    y: laneY[lane]! + (laneHpx[lane]! - stackH(items)) / 2 + above,
  };
};

const pos = new Map(
  d.placed.map((p) => {
    const { x, y } = place(p.col, p.lane, p.activity.id);
    return [p.activity.id, { x, y, cy: y + NODEH / 2, p }];
  })
);

// Edges attach to the card, never to an echo: an artifact is handed over once,
// and a second curve into the same activity would count the handoff twice.
const echoes = d.placed.flatMap((p) =>
  p.echoes.map((lane) => ({ p, lane, ...place(p.col, lane, p.activity.id) }))
);

const bezier = (t: number, a: number, c1: number, c2: number, b: number) =>
  (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * c1 + 3 * (1 - t) * t ** 2 * c2 + t ** 3 * b;

const paths = d.edges.map((e) => {
  const a = pos.get(e.from)!;
  const b = pos.get(e.to)!;
  const x1 = a.x + NODEW;
  const y1 = a.cy;
  const x2 = b.x;
  const y2 = b.cy;
  const mx = (x1 + x2) / 2;
  const t = 0.5;
  return {
    ...e,
    d: `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`,
    mx: bezier(t, x1, mx, mx, x2),
    my: bezier(t, y1, y1, y2, y2),
    roles: [...new Set([...team.activities.find((t2) => t2.id === e.from)!.roles, ...team.activities.find((t2) => t2.id === e.to)!.roles])].join(' '),
  };
});

const artifactName = (id: string) => nameOf(team.artifacts, id);

// A column is a step in the topological order — the only horizontal unit this
// figure can honestly name. Stages are not drawn here: their activities interleave
// across columns, so a stage band would sit above boxes of another stage. Stage
// lives on each box, in GRID's columns, and in the drawer.
const stageName = (id: string) => nameOf(team.stages, id);
const roleName = (id: string) => nameOf(team.roles, id);
const steps = Array.from({ length: d.cols }, (_, c) => ({
  col: c,
  acts: d.placed.filter((p) => p.col === c).length,
}));

// Idle cells: step×lane cells no activity touches get a quiet hatch so empty space reads as claimed.
// An echo counts as touching it — the role really is in that work, and hatching
// the cell would say the opposite of the label sitting in it.
const idleCells = steps.flatMap((s) =>
  team.roles.flatMap((_, l) =>
    cells.has(cellKey(s.col, l))
      ? []
      : [{ x: GUTTER + s.col * COLW, y: laneY[l]!, w: COLW, h: laneHpx[l]!, last: s.col === d.cols - 1 }]
  )
);
---

<section class="module fig" aria-label="Flow">
  <div class="module__head">
    <span class="tab">FLOW</span>
    <span class="module__title">Who Hands What to Whom</span>
    <span class="fig__scrollhint" aria-hidden="true">scroll →</span>
    <span class="module__meta">columns are steps · topological · ordinal, not time · stage sits on the box · select a card to light what it hands over</span>
  </div>
  <div class="fig__scroll">
    <div class="fig__canvas" data-flow style={`min-width:${width}px;height:${height}px`}>
      <svg width="100%" height={height} role="img" aria-label="Activity flow: artifact handoffs between roles">
        <defs>
          <pattern id={hatchId} width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="0" y2="7" stroke="#e4e4e0" stroke-width="1" />
          </pattern>
        </defs>
        {steps.map((s) => (
          <rect
            x={GUTTER + s.col * COLW}
            y={0}
            width={s.col === d.cols - 1 ? '100%' : COLW}
            height={height}
            fill={s.col % 2 ? '#f7f7f7' : '#ffffff'}
          />
        ))}
        {idleCells.map((c) => (
          <rect x={c.x} y={c.y} width={c.last ? '100%' : c.w} height={c.h} fill={`url(#${hatchId})`} />
        ))}
        {team.roles.map((_, i) => (
          <line x1={0} x2="100%" y1={laneY[i]} y2={laneY[i]} stroke="#dadada" stroke-width="1" />
        ))}
        <line x1={0} x2="100%" y1={height - 0.5} y2={height - 0.5} stroke="#dadada" stroke-width="1" />
        <line x1={GUTTER - 0.5} x2={GUTTER - 0.5} y1={0} y2={height} stroke="#dadada" stroke-width="1" />
        {paths.map((e) => (
          <path
            d={e.d}
            fill="none"
            stroke={e.constraint ? '#0f6b3c' : e.handoff ? '#666666' : '#bbbbbb'}
            stroke-width={e.constraint ? 1.5 : 1}
            data-roles={e.roles}
            data-from={e.from}
            data-to={e.to}
            data-artifact={e.artifact}
            class={`fig__edge${e.constraint ? ' fig__edge--constraint' : ''}`}
          />
        ))}
      </svg>

      {steps.map((s) => (
        <div class="fig__stephead" style={`left:${GUTTER + s.col * COLW + 8}px;top:4px;max-width:${COLW - 16}px`}>
          <span class="tab">STEP {String(s.col + 1).padStart(2, '0')}</span>
          <span class="fig__stepmeta">{s.acts} ACT</span>
        </div>
      ))}

      {team.roles.map((r, i) => (
        <div class="fig__lane" style={`top:${laneY[i]}px;height:${laneHpx[i]}px`} data-roles={r.id}>
          <button type="button" class="fig__lane-name" data-detail-key={`role:${r.id}`}>{r.name}</button>
          <span class="fig__lane-note">{r.note}</span>
        </div>
      ))}

      {/* One label per edge, not one per artifact. Fan-out used to share a single
          label, chosen by whichever midpoint sat lowest — which assumed the
          consumers of one artifact sit near each other. They do not: bug-report
          leaves triage on two curves 600px apart, and "lowest" put the only name
          on the far one, leaving the curve beside the producer bare. An edge that
          carries a document says which document.
          Only a hand-off wears its label at rest. A same-role edge is one
          person's own next step, and naming what they passed to themselves is a
          box the reader has to skip past. It becomes worth reading the moment
          they ask about that one activity, so the label is drawn either way and
          the selection is what lets the quiet ones speak. */}
      {paths.map((e) => (
        <button
          type="button"
          class={`fig__artifact${e.constraint ? ' fig__artifact--constraint' : ''}${e.handoff ? '' : ' fig__artifact--quiet'}`}
          style={`left:${e.mx}px;top:${e.my}px`}
          data-roles={e.roles}
          data-from={e.from}
          data-to={e.to}
          data-artifact={e.artifact}
          data-detail-key={`artifact:${e.artifact}`}
          aria-label={`${artifactName(e.artifact)} — details`}
        >
          {e.constraint && <span class="fig__one" aria-label="the constraint">①</span>}
          {artifactName(e.artifact)}
          {e.constraint && team.constraint && (
            <span class="fig__artifact-note">{team.constraint.note}</span>
          )}
        </button>
      ))}

      {d.placed.map((p) => {
        const at = pos.get(p.activity.id)!;
        const kids = p.activity.activities?.length ?? 0;
        return (
          <div
            class="fig__node"
            data-nodebox
            data-act={p.activity.id}
            style={`left:${at.x}px;top:${at.y}px;width:${NODEW}px`}
          >
            <button
              class={`fig__act${p.activity.open ? ' fig__act--open' : ''}`}
              style={`min-height:${NODEH}px`}
              data-act={p.activity.id}
              data-fills={p.activity.tooling?.tool}
              data-roles={p.activity.roles.join(' ')}
              data-depth="0"
              aria-label={`${p.activity.name} — details`}
            >
              <span class="fig__act-stage">{stageName(p.activity.stage)}</span>
              <span class="fig__act-name">{p.activity.name}</span>
              {/* Three states, and the third one draws nothing: an activity with
                  neither a fill nor a declared slot is work the team does itself,
                  and a ladder reading zero would state a gap nobody claimed. */}
              {statesCapability(p.activity) && (
                <span class="fig__act-level">
                  <span class="fig__act-level-name">
                    {p.activity.tooling ? LEVEL_LABELS[p.activity.tooling.level] : 'OPEN SLOT'}
                  </span>
                  <span
                    class={`fig__act-track${p.activity.tooling ? '' : ' fig__act-track--open'}`}
                    aria-hidden="true"
                    style={`--lv:${
                      p.activity.tooling ? LEVEL_ORDER.indexOf(p.activity.tooling.level) : 0
                    }`}
                  >
                    <span class="fig__act-fill" />
                  </span>
                </span>
              )}
            </button>


            {kids > 0 && (
              <button
                class="fig__expand"
                data-expand={p.activity.id}
                data-roles={p.activity.roles.join(' ')}
                aria-expanded="false"
                aria-label={`Expand sub-process of ${p.activity.name}`}
              >
                ▸ {kids} INSIDE
              </button>
            )}
            {kids > 0 && (
              <div
                class="fig__inset"
                data-subflow-panel={p.activity.id}
                data-roles={p.activity.roles.join(' ')}
                hidden
              >
                <div class="fig__inset-head">
                  <span class="fig__inset-title">SUB-PROCESS — {p.activity.name}</span>
                  <span class="fig__inset-meta">same lanes, inside {team.stages.find((s) => s.id === p.activity.stage)?.name}</span>
                </div>
                <SubFlow team={team} activities={p.activity.activities!} />
              </div>
            )}
          </div>
        );
      })}

      {echoes.map((e) => (
        <button
          class="fig__echo"
          style={`left:${e.x}px;top:${e.y}px;width:${NODEW}px;min-height:${ECHOH}px`}
          data-nodebox
          data-act={e.p.activity.id}
          data-fills={e.p.activity.tooling?.tool}
          data-roles={e.p.activity.roles.join(' ')}
          data-depth="0"
          aria-label={`${e.p.activity.name} — shared with ${roleName(team.roles[e.lane]!.id)}, card in the ${roleName(team.roles[e.p.lane]!.id)} lane — details`}
        >
          {e.p.activity.name}
        </button>
      ))}
    </div>
  </div>
  {team.constraint && (
    <p class="fig__note" tabindex="0" data-roles={team.roles.map((r) => r.id).join(' ')}>
      <span class="fig__one" aria-hidden="true">①</span>
      <span class="fig__note-text">{team.constraint.note}</span>
    </p>
  )}
</section>

<style>
  /* `overflow-x: auto` alone computes `overflow-y` to `auto` as well, and the
     horizontal scrollbar then eats 10px out of a canvas that is exactly as tall
     as its content — so the figure grew a second, nested vertical scrollbar for
     ten pixels it did not need. The figure is drawn at full height and the page
     scrolls it; only sideways travel belongs to the figure itself. The padding
     gives the horizontal bar its own strip instead of it covering the closing
     hairline. */
  .fig__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 10px;
  }
  .fig__canvas {
    position: relative;
  }
  .fig__scrollhint {
    display: none;
    font-size: var(--micro);
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .fig__scrollhint {
      display: inline;
    }
  }
  .fig__stephead {
    position: absolute;
    display: flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
  }
  .fig__stepmeta {
    font-size: var(--micro);
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--sub);
    font-weight: 600;
    white-space: nowrap;
  }
  .fig__lane {
    position: absolute;
    left: 0;
    width: 150px;
    padding: 8px 10px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  /* The label became a button when artifacts and roles got a panel of their own.
     It keeps the label's exact skin — the global button reset plus the same box —
     so the figure reads as it did and only the pointer says the name now opens
     something. */
  .fig__lane-name {
    font-size: var(--body);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: left;
  }
  .fig__lane-note {
    font-size: var(--micro);
    line-height: 12px;
    color: var(--sub);
  }
  /* Card, expand toggle, and inset stack in flow inside one placed box — a name
     that wraps to a third line pushes the toggle down instead of colliding with it. */
  .fig__node {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .fig__act {
    background: var(--white);
    border: 1px solid var(--ink);
    padding: 7px 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 3px;
    transition: background 0.12s ease-out, color 0.12s ease-out, opacity 0.28s var(--ease-out);
  }
  .fig__act-stage {
    font-size: var(--micro);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .fig__act:hover {
    background: var(--washi);
  }
  .fig__act--open {
    border-style: dashed;
    border-color: var(--muted);
    background-color: var(--washi);
    background-image: var(--stripe);
  }
  .fig__act-name {
    font-size: 11px;
    line-height: 13px;
    font-weight: 700;
  }
  /* The level names itself and shows its place: the word answers "which level",
     the 2px track under it answers "how far along the ramp" without spending a
     second row. The word sits a step under --micro because at this size the track
     carries the scan and the text is only read on the card you stopped at. */
  .fig__act-level {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1;
    font-size: 8px;
    letter-spacing: 0.08em;
    color: var(--sub);
  }
  .fig__act-track {
    height: 2px;
    background: var(--line);
  }
  .fig__act-fill {
    display: block;
    height: 100%;
    width: calc((var(--lv) + 1) / 4 * 100%);
    background: var(--accent);
  }
  .fig__act-track--open .fig__act-fill {
    width: 0;
  }
  .fig__act[aria-current='true'] .fig__act-track {
    background: rgba(255, 255, 255, 0.25);
  }
  .fig__act[aria-current='true'] .fig__act-fill {
    background: var(--accent-on-ink);
  }
  .fig__act--open:hover {
    border-color: var(--ink);
  }
  .fig__act--open .fig__act-level {
    color: var(--accent);
    font-weight: 700;
  }
  /* Selection inverts to ink: on a figure of a hundred nodes a light mark has to be
     hunted for, and a mark the reader hunts for reads as a click that did nothing.
     The spine stays signal green rather than the mint variant — a 2px border is
     read as a shape, not as text, so it does not owe text contrast. Captions do,
     which is why they drop to muted here. The background shorthand is deliberate:
     it clears the open slot's stripe, so a selected open slot reads as one solid
     object rather than an inverted card with a hatch still running through it. */
  .fig__act[aria-current='true'] {
    background: var(--ink);
    border: 1px solid var(--ink);
    border-left: 2px solid var(--accent);
    color: var(--white);
  }
  .fig__act[aria-current='true'] .fig__act-stage,
  .fig__act[aria-current='true'] .fig__act-level {
    color: var(--muted);
  }
  /* The same activity, named again in a lane that shares it but does not lead it.
     It takes the artifact label's skin — hairline box, micro type, sub colour —
     rather than a skin of its own, because that is already this figure's voice for
     "a thing drawn in full elsewhere", and a second card would read as a second
     activity. It carries the same `data-act`, so one click marks the card and every
     echo of it at once, exactly as an artifact marks every edge that carries it.
     No green spine here: the spine belongs to the card being read, and an echo is
     a pointer to that card. */
  .fig__echo {
    position: absolute;
    background: var(--white);
    border: 1px solid var(--line);
    padding: 4px 6px;
    text-align: left;
    font-size: var(--micro);
    line-height: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--sub);
    transition: background 0.12s ease-out, color 0.12s ease-out,
      border-color 0.12s ease-out, opacity 0.28s var(--ease-out);
  }
  .fig__echo:hover {
    background: var(--washi);
    border-color: var(--ink);
    color: var(--ink);
  }
  .fig__echo[aria-current='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .fig__expand {
    z-index: 5;
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-align: left;
    padding: 3px 0 2px;
    transition: opacity 0.28s var(--ease-out);
  }
  .fig__expand[aria-expanded='true'] {
    color: var(--ink);
  }
  .fig__inset {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 2px;
    z-index: 6;
    background: var(--white);
    border: 1px solid var(--ink);
    /* white halo separates the overlay from occluded lane content beneath it */
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.94);
    padding: 8px 10px 6px;
    min-width: 420px;
    max-width: 720px;
    transition: opacity 0.28s var(--ease-out);
  }
  .fig__inset-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 5px;
    margin-bottom: 4px;
  }
  .fig__inset-title {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .fig__inset-meta {
    margin-left: auto;
    font-size: var(--micro);
    color: var(--sub);
    letter-spacing: 0.04em;
  }
  .fig__artifact,
  .fig__lane,
  [data-nodebox] {
    transition: opacity 0.28s var(--ease-out);
  }
  /* A real process draws more curves than a reader can follow at once, and at full
     weight they cross the cards rather than pass behind them. So the edge layer
     rests as a hint of where the work travels, and answers "where does this one
     go?" only when asked: selecting a node — or an artifact — brings its own edges
     back to full weight and pushes the rest further down. The constraint rests
     louder than the others because it is the one edge the document argues about.
     Whatever an edge does its label does, so a name never floats free of the
     curve it belongs to. */
  .fig__edge {
    opacity: 0.34;
    transition: opacity 0.28s var(--ease-out), stroke-width 0.16s var(--ease-out);
  }
  .fig__edge--constraint {
    opacity: 0.75;
  }
  [data-flow][data-lens] .fig__edge {
    opacity: 0.1;
  }
  [data-flow][data-lens] .fig__edge.is-lit {
    opacity: 1;
    stroke-width: 2;
  }
  [data-flow][data-lens] .fig__artifact {
    opacity: 0.22;
  }
  /* The cards follow the edges: a selection fades the work it does not touch, so
     what is left at full strength is the neighbourhood — the activity, what it
     was handed, and who it hands to. Faded is not gone; the shape of the figure
     stays readable behind the answer. */
  [data-flow][data-lens] [data-nodebox] {
    opacity: 0.3;
  }
  [data-flow][data-lens] [data-nodebox].is-near {
    opacity: 1;
  }
  /* A lit label brightens where it already sits and no further: raising it over
     the cards buys one legible name at the cost of covering an activity, and the
     cards are the layer the figure is read from. */
  [data-flow][data-lens] .fig__artifact.is-lit {
    opacity: 1;
  }
  .fig__lane-name:hover,
  .fig__lane-name:focus-visible {
    color: var(--accent);
  }
  .fig__artifact {
