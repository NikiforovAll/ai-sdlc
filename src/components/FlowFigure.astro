---
import type { Team } from '../lib/derive';
import { derive, LEVEL_LABELS, LEVEL_ORDER } from '../lib/derive';
import SubFlow from './SubFlow.astro';

interface Props {
  team: Team;
  /** Suffixes the SVG pattern id — the export holds one figure per process in one file. */
  docId?: string;
}
const { team, docId = 'doc' } = Astro.props;
const d = derive(team);
const hatchId = `idle-hatch-${docId}`;

const GUTTER = 150;
const BAND = 26;
const COLW = 150;
const LANEH = 112;
const NODEW = 126;
// NODEH is the layout unit, not a cap: a card grows with its name, so the stack
// reserves the tallest a card gets (three name lines) rather than the shortest.
const NODEH = 70;
const NODEH_MAX = 90;
const STACK_GAP = 10;
const EXPAND_H = 22;

const actById = new Map(d.placed.map((p) => [p.activity.id, p.activity]));
const expandExtra = (id: string) => ((actById.get(id)?.activities?.length ?? 0) > 0 ? EXPAND_H : 0);

// Two parallel activities can land on the same (column, lane) slot; lanes grow
// to hold their deepest stack instead of letting nodes overlap.
const slotKey = (p: (typeof d.placed)[number]) => `${p.col}:${p.laneStart}:${p.laneEnd}`;
const slots = new Map<string, string[]>();
for (const p of d.placed) {
  const k = slotKey(p);
  slots.set(k, [...(slots.get(k) ?? []), p.activity.id]);
}
const laneUnits = team.roles.map((_, l) => {
  let units = 1;
  for (const p of d.placed) {
    if (p.laneStart === p.laneEnd && p.laneStart === l) {
      units = Math.max(units, slots.get(slotKey(p))!.length);
    }
  }
  return units;
});
const laneY: number[] = [];
let acc = BAND;
for (const u of laneUnits) {
  laneY.push(acc);
  acc += u * LANEH;
}
const laneHpx = laneUnits.map((u) => u * LANEH);

const width = GUTTER + d.cols * COLW;
const height = acc;

const pos = new Map(
  d.placed.map((p) => {
    const x = GUTTER + p.col * COLW + (COLW - NODEW) / 2;
    const stack = slots.get(slotKey(p))!;
    const k = stack.indexOf(p.activity.id);
    const n = stack.length;
    const spanH = laneHpx.slice(p.laneStart, p.laneEnd + 1).reduce((a, b) => a + b, 0);
    const stackH = stack.reduce((a, id) => a + NODEH_MAX + expandExtra(id), 0) + (n - 1) * STACK_GAP;
    const above = stack.slice(0, k).reduce((a, id) => a + NODEH_MAX + expandExtra(id) + STACK_GAP, 0);
    const y = laneY[p.laneStart]! + (spanH - stackH) / 2 + above;
    return [p.activity.id, { x, y, cy: y + NODEH / 2, p }];
  })
);

const bezier = (t: number, a: number, c1: number, c2: number, b: number) =>
  (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * c1 + 3 * (1 - t) * t ** 2 * c2 + t ** 3 * b;

const paths = d.edges.map((e) => {
  const a = pos.get(e.from)!;
  const b = pos.get(e.to)!;
  const x1 = a.x + NODEW;
  const y1 = a.cy;
  const x2 = b.x;
  const y2 = b.cy;
  const mx = (x1 + x2) / 2;
  const t = 0.5;
  return {
    ...e,
    d: `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`,
    mx: bezier(t, x1, mx, mx, x2),
    my: bezier(t, y1, y1, y2, y2),
    roles: [...new Set([...team.activities.find((t2) => t2.id === e.from)!.roles, ...team.activities.find((t2) => t2.id === e.to)!.roles])].join(' '),
  };
});

const artifactName = (id: string) => team.artifacts.find((a) => a.id === id)?.name ?? id;

// One label per (producer, artifact) — fan-out edges share it; keep the lowest, clearest spot.
const labelEdges = [
  ...paths
    .filter((e) => e.handoff)
    .reduce((m, e) => {
      const k = `${e.from}:${e.artifact}`;
      const prev = m.get(k);
      if (!prev || e.my > prev.my) m.set(k, e);
      return m;
    }, new Map<string, (typeof paths)[number]>())
    .values(),
];

// A column is a step in the topological order — the only horizontal unit this
// figure can honestly name. Stages are not drawn here: their activities interleave
// across columns, so a stage band would sit above boxes of another stage. Stage
// lives on each box, in GRID's columns, and in the drawer.
const stageName = (id: string) => team.stages.find((s) => s.id === id)?.name ?? id;
const steps = Array.from({ length: d.cols }, (_, c) => ({
  col: c,
  acts: d.placed.filter((p) => p.col === c).length,
}));

// Idle cells: step×lane cells no activity touches get a quiet hatch so empty space reads as claimed.
const idleCells = steps.flatMap((s) =>
  team.roles.flatMap((_, l) => {
    const occupied = d.placed.some((p) => p.col === s.col && p.laneStart <= l && l <= p.laneEnd);
    return occupied ? [] : [{ x: GUTTER + s.col * COLW, y: laneY[l]!, w: COLW, h: laneHpx[l]!, last: s.col === d.cols - 1 }];
  })
);
---

<section class="module fig" aria-label="Flow">
  <div class="module__head">
    <span class="tab">FLOW</span>
    <span class="module__title">Who Hands What to Whom</span>
    <span class="fig__scrollhint" aria-hidden="true">scroll →</span>
    <span class="module__meta">columns are steps · topological · ordinal, not time · stage sits on the box</span>
  </div>
  <div class="fig__scroll">
    <div class="fig__canvas" style={`min-width:${width}px;height:${height}px`}>
      <svg width="100%" height={height} role="img" aria-label="Activity flow: artifact handoffs between roles">
        <defs>
          <pattern id={hatchId} width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="0" y2="7" stroke="#e4e4e0" stroke-width="1" />
          </pattern>
        </defs>
        {steps.map((s) => (
          <rect
            x={GUTTER + s.col * COLW}
            y={0}
            width={s.col === d.cols - 1 ? '100%' : COLW}
            height={height}
            fill={s.col % 2 ? '#f7f7f7' : '#ffffff'}
          />
        ))}
        {idleCells.map((c) => (
          <rect x={c.x} y={c.y} width={c.last ? '100%' : c.w} height={c.h} fill={`url(#${hatchId})`} />
        ))}
        {team.roles.map((_, i) => (
          <line x1={0} x2="100%" y1={laneY[i]} y2={laneY[i]} stroke="#dadada" stroke-width="1" />
        ))}
        <line x1={0} x2="100%" y1={height - 0.5} y2={height - 0.5} stroke="#dadada" stroke-width="1" />
        <line x1={GUTTER - 0.5} x2={GUTTER - 0.5} y1={0} y2={height} stroke="#dadada" stroke-width="1" />
        {paths.map((e) => (
          <path
            d={e.d}
            fill="none"
            stroke={e.constraint ? '#0f6b3c' : e.handoff ? '#666666' : '#bbbbbb'}
            stroke-width={e.constraint ? 2 : 1.5}
            data-roles={e.roles}
            data-edge={`${e.from}->${e.to}`}
            class="fig__edge"
          />
        ))}
      </svg>

      {steps.map((s) => (
        <div class="fig__stephead" style={`left:${GUTTER + s.col * COLW + 8}px;top:4px;max-width:${COLW - 16}px`}>
          <span class="tab">STEP {String(s.col + 1).padStart(2, '0')}</span>
          <span class="fig__stepmeta">{s.acts} ACT</span>
        </div>
      ))}

      {team.roles.map((r, i) => (
        <div class="fig__lane" style={`top:${laneY[i]}px;height:${laneHpx[i]}px`} data-roles={r.id}>
          <button type="button" class="fig__lane-name" data-detail-key={`role:${r.id}`}>{r.name}</button>
          <span class="fig__lane-note">{r.note}</span>
        </div>
      ))}

      {labelEdges.map((e) => (
        <button
          type="button"
          class={`fig__artifact${e.constraint ? ' fig__artifact--constraint' : ''}`}
          style={`left:${e.mx}px;top:${e.my}px`}
          data-roles={e.roles}
          data-detail-key={`artifact:${e.artifact}`}
          aria-label={`${artifactName(e.artifact)} — details`}
        >
          {e.constraint && <span class="fig__one" aria-label="the constraint">①</span>}
          {artifactName(e.artifact)}
          {e.constraint && team.constraint && (
            <span class="fig__artifact-note">{team.constraint.note}</span>
          )}
        </button>
      ))}

      {d.placed.map((p) => {
        const at = pos.get(p.activity.id)!;
        const kids = p.activity.activities?.length ?? 0;
        return (
          <div class="fig__node" style={`left:${at.x}px;top:${at.y}px;width:${NODEW}px`}>
            <button
              class={`fig__act${p.activity.tooling ? '' : ' fig__act--open'}`}
              style={`min-height:${NODEH}px`}
              data-act={p.activity.id}
              data-fills={p.activity.tooling?.tool}
              data-roles={p.activity.roles.join(' ')}
              data-depth="0"
              aria-label={`${p.activity.name} — details`}
            >
              <span class="fig__act-stage">{stageName(p.activity.stage)}</span>
              <span class="fig__act-name">{p.activity.name}</span>
              <span class="fig__act-level">
                <span class="fig__act-level-name">
                  {p.activity.tooling ? LEVEL_LABELS[p.activity.tooling.level] : 'OPEN SLOT'}
                </span>
                <span
                  class={`fig__act-track${p.activity.tooling ? '' : ' fig__act-track--open'}`}
                  aria-hidden="true"
                  style={`--lv:${
                    p.activity.tooling ? LEVEL_ORDER.indexOf(p.activity.tooling.level) : 0
                  }`}
                >
                  <span class="fig__act-fill" />
                </span>
              </span>
            </button>


            {kids > 0 && (
              <button
                class="fig__expand"
                data-expand={p.activity.id}
                data-roles={p.activity.roles.join(' ')}
                aria-expanded="false"
                aria-label={`Expand sub-process of ${p.activity.name}`}
              >
                ▸ {kids} INSIDE
              </button>
            )}
            {kids > 0 && (
              <div
                class="fig__inset"
                data-subflow-panel={p.activity.id}
                data-roles={p.activity.roles.join(' ')}
                hidden
              >
                <div class="fig__inset-head">
                  <span class="fig__inset-title">SUB-PROCESS — {p.activity.name}</span>
                  <span class="fig__inset-meta">same lanes, inside {team.stages.find((s) => s.id === p.activity.stage)?.name}</span>
                </div>
                <SubFlow team={team} activities={p.activity.activities!} />
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
  {team.constraint && (
    <p class="fig__note" tabindex="0" data-roles={team.roles.map((r) => r.id).join(' ')}>
      <span class="fig__one" aria-hidden="true">①</span>
      <span class="fig__note-text">{team.constraint.note}</span>
    </p>
  )}
</section>

<style>
  /* `overflow-x: auto` alone computes `overflow-y` to `auto` as well, and the
     horizontal scrollbar then eats 10px out of a canvas that is exactly as tall
     as its content — so the figure grew a second, nested vertical scrollbar for
     ten pixels it did not need. The figure is drawn at full height and the page
     scrolls it; only sideways travel belongs to the figure itself. The padding
     gives the horizontal bar its own strip instead of it covering the closing
     hairline. */
  .fig__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 10px;
  }
  .fig__canvas {
    position: relative;
  }
  .fig__scrollhint {
    display: none;
    font-size: var(--micro);
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .fig__scrollhint {
      display: inline;
    }
  }
  .fig__stephead {
    position: absolute;
    display: flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
  }
  .fig__stepmeta {
    font-size: var(--micro);
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--sub);
    font-weight: 600;
    white-space: nowrap;
  }
  .fig__lane {
    position: absolute;
    left: 0;
    width: 150px;
    padding: 8px 10px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  /* The label became a button when artifacts and roles got a panel of their own.
     It keeps the label's exact skin — the global button reset plus the same box —
     so the figure reads as it did and only the pointer says the name now opens
     something. */
  .fig__lane-name {
    font-size: var(--body);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: left;
  }
  .fig__lane-note {
    font-size: var(--micro);
    line-height: 12px;
    color: var(--sub);
  }
  /* Card, expand toggle, and inset stack in flow inside one placed box — a name
     that wraps to a third line pushes the toggle down instead of colliding with it. */
  .fig__node {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .fig__act {
    background: var(--white);
    border: 1px solid var(--ink);
    padding: 7px 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 3px;
    transition: background 0.12s ease-out, color 0.12s ease-out, opacity 0.28s var(--ease-out);
  }
  .fig__act-stage {
    font-size: var(--micro);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sub);
  }
  .fig__act:hover {
    background: var(--washi);
  }
  .fig__act--open {
    border-style: dashed;
    border-color: var(--muted);
    background-color: var(--washi);
    background-image: var(--stripe);
  }
  .fig__act-name {
    font-size: 11px;
    line-height: 13px;
    font-weight: 700;
  }
  /* The level names itself and shows its place: the word answers "which level",
     the 2px track under it answers "how far along the ramp" without spending a
     second row. The word sits a step under --micro because at this size the track
     carries the scan and the text is only read on the card you stopped at. */
  .fig__act-level {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1;
    font-size: 8px;
    letter-spacing: 0.08em;
    color: var(--sub);
  }
  .fig__act-track {
    height: 2px;
    background: var(--line);
  }
  .fig__act-fill {
    display: block;
    height: 100%;
    width: calc((var(--lv) + 1) / 4 * 100%);
    background: var(--accent);
  }
  .fig__act-track--open .fig__act-fill {
    width: 0;
  }
  .fig__act[aria-current='true'] .fig__act-track {
    background: rgba(255, 255, 255, 0.25);
  }
  .fig__act[aria-current='true'] .fig__act-fill {
    background: var(--accent-on-ink);
  }
  .fig__act--open:hover {
    border-color: var(--ink);
  }
  .fig__act--open .fig__act-level {
    color: var(--accent);
    font-weight: 700;
  }
  /* Selection inverts to ink: on a figure of a hundred nodes a light mark has to be
     hunted for, and a mark the reader hunts for reads as a click that did nothing.
     The spine stays signal green rather than the mint variant — a 2px border is
     read as a shape, not as text, so it does not owe text contrast. Captions do,
     which is why they drop to muted here. The background shorthand is deliberate:
     it clears the open slot's stripe, so a selected open slot reads as one solid
     object rather than an inverted card with a hatch still running through it. */
  .fig__act[aria-current='true'] {
    background: var(--ink);
    border: 1px solid var(--ink);
    border-left: 2px solid var(--accent);
    color: var(--white);
  }
  .fig__act[aria-current='true'] .fig__act-stage,
  .fig__act[aria-current='true'] .fig__act-level {
    color: var(--muted);
  }
  .fig__expand {
    z-index: 5;
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-align: left;
    padding: 3px 0 2px;
    transition: opacity 0.28s var(--ease-out);
  }
  .fig__expand[aria-expanded='true'] {
    color: var(--ink);
  }
  .fig__inset {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 2px;
    z-index: 6;
    background: var(--white);
    border: 1px solid var(--ink);
    /* white halo separates the overlay from occluded lane content beneath it */
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.94);
    padding: 8px 10px 6px;
    min-width: 420px;
    max-width: 720px;
    transition: opacity 0.28s var(--ease-out);
  }
  .fig__inset-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 5px;
    margin-bottom: 4px;
  }
  .fig__inset-title {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .fig__inset-meta {
    margin-left: auto;
    font-size: var(--micro);
    color: var(--sub);
    letter-spacing: 0.04em;
  }
  .fig__edge,
  .fig__artifact,
  .fig__lane {
    transition: opacity 0.28s var(--ease-out);
  }
  .fig__lane-name:hover,
  .fig__lane-name:focus-visible {
    color: var(--accent);
  }
  .fig__artifact {
    position: absolute;
    transform: translate(-50%, -50%);
    background: var(--white);
    border: 1px solid var(--line);
    font-size: var(--micro);
    letter-spacing: 0.04em;
    padding: 2px 5px;
    white-space: nowrap;
    color: var(--sub);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .fig__artifact:hover,
  .fig__artifact:focus-visible {
    border-color: var(--accent);
    color: var(--ink);
  }
  .fig__artifact--constraint {
    border-color: var(--accent);
    color: var(--ink);
    font-weight: 700;
    cursor: help;
  }
  /* The label carries the ① but not the sentence behind it, so the note opens
     from the label itself as well as from the corner chip — the reader asking
     "why is this one marked?" is looking at the label, not the corner.
     `white-space: normal` is not decoration: the label sets `nowrap` and the
     panel inherits it, which runs the whole sentence off one line. */
  /* One skin, two placements: the constraint speaks from the artifact label and
     from the pinned corner chip, and a reader has to recognise them as the same
     object saying the same thing. Mint is the edge because the chip floats over
     the figure's own white and washi bands and needs a border that is not a
     fourth colour — it is the voice the ① inside it already speaks in. */
  .fig__artifact-note,
  .fig__note {
    background: var(--ink);
    color: var(--white);
    border: 1px solid var(--accent-on-ink);
    padding: 8px 10px;
    font-size: 11px;
    line-height: 15px;
  }
  .fig__artifact-note {
    display: none;
    position: absolute;
    left: -1px;
    top: calc(100% + 5px);
    width: 44ch;
    max-width: 60vw;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    white-space: normal;
    z-index: 25;
  }
  .fig__artifact:hover,
  .fig__artifact:focus-visible {
    z-index: 26;
  }
  .fig__artifact:hover .fig__artifact-note,
  .fig__artifact:focus-visible .fig__artifact-note {
    display: block;
  }
  .fig__one {
    color: var(--accent);
    font-weight: 700;
    font-size: var(--body);
  }
  /* The constraint is the one fact a reader may want at any point in a figure
     that is taller and wider than the screen, and it used to sit at the very
     foot — reachable only after scrolling past everything it explains. It keeps
     a fixed corner instead, showing the ① alone until hover or focus opens the
     note. The two states swap rather than grow into each other: a collapsed text
     column is still a column of text, so every attempt to animate it to zero
     width simply wrapped the note one character per line into a black tower. The
     mark is legible standing still, which is the rule this world reads by. */
  .fig__note {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 30;
    display: flex;
    align-items: flex-start;
    max-width: calc(100vw - 28px);
  }
  .fig__note-text {
    display: none;
    width: 46ch;
    max-width: 100%;
    padding-left: 7px;
  }
  .fig__note:hover .fig__note-text,
  .fig__note:focus-visible .fig__note-text {
    display: block;
  }
  .fig__note .fig__one {
    color: var(--accent-on-ink);
  }
</style>
